/*! @brief http base message object  */
interface HttpMessage : Message
{
    /*! @brief protocol version information, the allowed format is: HTTP/#.# */
    String protocol;

    /*! @brief container holding the http headers of the message, read-only property */
    readonly Headers headers;

    /*! @brief queries and sets whether to keep the connection alive */
    Boolean keepAlive;

    /*! @brief queries and sets whether the protocol is upgraded */
    Boolean upgrade;

    /*! @brief queries and sets the maximum number of request headers, default is 128 */
    Integer maxHeadersCount;

    /*! @brief queries and sets the maximum request header length, default is 8192 */
    Integer maxHeaderSize;

    /*! @brief queries and sets the maximum chunk size in MB, default is 2 */
    Integer maxChunkSize;

    /*! @brief queries and sets the maximum body size in MB, default is 64 */
    Integer maxBodySize;

    /*! @brief queries the source socket of the current object */
    readonly Stream socket;

    /*! @brief checks whether a header of the specified key exists
     @param name specifies the key to check
     @return returns whether the key exists
     */
    Boolean hasHeader(String name);

    /*! @brief queries the first header of the specified key
     @param name specifies the key to query
     @return returns the value corresponding to the key, or undefined if it does not exist
     */
    String firstHeader(String name);

    /*! @brief queries all headers of the specified key
     @param name specifies the key to query; passing an empty string returns the result of all keys
     @return returns an array of all values corresponding to the key, or null if the data does not exist
     */
    NObject allHeader(String name = "");

    /*! @brief appends a header; appending data does not modify the headers of an existing key
     @param map specifies the key-value data dictionary to append
     */
    appendHeader(Object map);

    /*! @brief appends headers; appending data does not modify the headers of an existing key
     @param headers specifies the Headers object to append
     */
    appendHeader(Headers headers);

    /*! @brief appends a group of headers with the specified name; appending data does not modify the headers of an existing key
     @param name specifies the key to append
     @param values specifies the group of data to append
     */
    appendHeader(String name, Array values);

    /*! @brief appends a header; appending data does not modify the headers of an existing key
     @param name specifies the key to append
     @param value specifies the data to append
     */
    appendHeader(String name, Variant value);

    /*! @brief sets a header; setting data modifies the first value of the key and clears the remaining headers with the same key
     @param map specifies the key-value data dictionary to set
     */
    setHeader(Object map);

    /*! @brief sets headers; setting data modifies the value of the key and clears the remaining headers with the same key
     @param headers specifies the Headers object to set
     */
    setHeader(Headers headers);

    /*! @brief sets a group of headers with the specified name; setting data modifies the value of the key and clears the remaining headers with the same key
     @param name specifies the key to set
     @param values specifies the group of data to set
     */
    setHeader(String name, Array values);

    /*! @brief sets a header; setting data modifies the first value of the key and clears the remaining headers with the same key
     @param name specifies the key to set
     @param value specifies the data to set
     */
    setHeader(String name, Variant value);

    /*! @brief deletes all headers of the specified key
     @param name specifies the key to delete
     */
    removeHeader(String name);

    /*! @brief queries the first header of the specified key
     @param name specifies the key to query
     @return returns the value corresponding to the key, or undefined if it does not exist
     */
    Value getHeader(String name);

    /*! @brief queries all headers
     @return returns the key-value pairs of all headers
     */
    NObject getHeaders();

    /*! @brief queries whether the headers have been sent */
    readonly Boolean headersSent;

    /*! @brief container holding the http trailer headers of the message, read-only property */
    readonly Headers trailers;

    /*! @brief adds trailer headers, which will be sent after the body
     @param headers specifies the trailer headers to add
     */
    addTrailers(Object headers);

    /*! @brief parses the message body into FormData according to Content-Type

     Only multipart/form-data (with a boundary parameter in Content-Type) and
     application/x-www-form-urlencoded are supported; other types throw a TypeError.

     @return returns the parsed FormData object
     */
    FormData formData() async;
};
