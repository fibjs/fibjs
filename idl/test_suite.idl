/*! @brief The test_suite module is a test suite module that can be called as a function */
module test_suite
{
    /*! @brief Defines a test suite, can be nested
     @param name defines the item name
     @param block the test content
     */
    static Function(String name, Function() block);

    /*! @brief Defines a test suite (with options), can be nested
     @param name defines the item name
     @param options the test options, supporting: { skip, todo, only }
     @param block the test content
     */
    static Function(String name, Object options, Function() block);

    /*! @brief Paused test suite item definition
     @param name defines the item name
     @param block the test content
     */
    static skip(String name, Function() block);

    /*! @brief Independent test suite item definition
     @param name defines the item name
     @param block the test content
     */
    static only(String name, Function() block);

    /*! @brief Planned test suite definition
     @param name defines the item name
     @param block the test content
     */
    static todo(String name, Function() block);

    /*! @brief Planned test suite definition (with options)
     @param name defines the item name
     @param options the test options, supporting: { skip, todo, only }
     @param block the test content
     */
    static todo(String name, Object options, Function() block);
};
