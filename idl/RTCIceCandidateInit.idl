/*! @brief Initialization dictionary of RTCIceCandidate.

 Both fields are optional: `candidate` defaults to an empty string, the
 end-of-candidates marker, and `sdpMid` defaults to null. The other fields of
 the standard dictionary (`sdpMLineIndex`, `usernameFragment`) are accepted
 and ignored by the constructor.

 Example 1 — build a candidate from its text:
 ```JavaScript
 const rtc = require('rtc');
 const c = new rtc.RTCIceCandidate({
     candidate: 'candidate:1 1 UDP 1 127.0.0.1 1000 typ host'
 });
 console.log(c.type); // host
 ```
 Example 2 — the end-of-candidates marker:
 ```JavaScript
 const rtc = require('rtc');
 const c = new rtc.RTCIceCandidate({});
 console.log(JSON.stringify(c.candidate)); // ""
 ```
 */
struct RTCIceCandidateInit {
    /*! @brief candidate string, empty for the end-of-candidates marker */
    String candidate = "";

    /*! @brief media line id, null by default */
    String sdpMid;
};
