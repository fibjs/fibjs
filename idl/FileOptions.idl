/*! @brief Options shared by the positional File constructors.

     Only `type`, `endings` and `lastModified` are read here; `lastModified`
     defaults to the current time when absent. `data` and `name` are legacy
     fields kept for source compatibility and are ignored by these constructors:
     the single-object form uses FileInit instead.
 */
struct FileOptions {
    String type = "";
    String endings = "transparent";
    Long lastModified;
    Buffer|String data;
    String name = "";
};
