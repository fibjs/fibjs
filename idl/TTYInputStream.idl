/*! @brief tty read stream object, used to read from and write to a tty

 There is no way to create this class separately; globally there is only the `process.stdin` instance

 ```JavaScript
 process.stdin.read(1)
 ```
 */
interface TTYInputStream : Stream
{
    /*! @brief Creates a new TTYInputStream object; the fd parameter specifies the underlying file descriptor
     @param fd the underlying file descriptor, which must be a tty device
     @param opts options object passed to the Stream constructor
     */
    TTYInputStream(Integer fd, Object opts = {});

    /*! @brief Creates a new TTYInputStream object; the fd parameter specifies the underlying file object
     @param fd the underlying file object, which must be a tty device
     @param opts options object passed to the Stream constructor
     */
    TTYInputStream(FileHandle fd, Object opts = {});

    /*! @brief Always true
    */
    readonly Boolean isTTY;

    /*! @brief Always true, indicating the stream is readable
    */
    readonly Boolean readable;

    /*! @brief Queries whether it is in raw mode; when true, it means the tty is configured to operate as a raw device
    */
    readonly Boolean isRaw;

    /*! @brief Sets whether the tty works in raw mode
     @param isRawMode true means it works in raw mode; otherwise it works in the default mode. `readStream.isRaw` is affected by this setting
     @return returns itself
     */
    TTYInputStream setRawMode(Boolean isRawMode);
};
