/*! @brief The DOMParser interface provides the ability to parse XML or HTML source code from a string into a DOM Document

 DOMParser can parse XML or HTML source code from a string into a DOM document:
 ```JavaScript
 const parser = new DOMParser();
 
 // Parse HTML
 const htmlDoc = parser.parseFromString('<html><body>Hello</body></html>', 'text/html');
 console.log(htmlDoc.body.textContent); // Output: Hello
 
 // Parse XML
 const xmlDoc = parser.parseFromString('<root><item>data</item></root>', 'text/xml');
 console.log(xmlDoc.documentElement.nodeName); // Output: root
 ```

 Supported MIME types include:
 - text/html - Parse as HTML document
 - text/xml - Parse as XML document
 - application/xml - Parse as XML document
 - application/xhtml+xml - Parse as XHTML document
 - image/svg+xml - Parse as SVG document
*/
interface DOMParser : object
{
    /*! @brief Construct a DOMParser object */
    DOMParser();

    /*! @brief Parse a string into a DOM document
     @param string The HTML or XML string to parse
     @param mimeType Specifies the text type, supports "text/html", "text/xml", "application/xml", "application/xhtml+xml", "image/svg+xml"
     @return Returns the parsed XmlDocument object
    */
    XmlDocument parseFromString(String string, String mimeType);
};
