/*! @brief Input output processing module

 Usage:
 ```JavaScript
 var io = require('io');
 ```
 */
module io
{
    /*! @brief Create a memory stream object, see MemoryStream */
    static MemoryStream;

    /*! @brief Create a buffered stream read object, see BufferedStream */
    static BufferedStream;

    /*! @brief Create a Range query stream read object, see RangeStream */
    static RangeStream;

    /*! @brief Copy stream data to target stream
     @param from Source stream object
     @param to Target stream object
     @param bytes Number of bytes to copy
     @return Return the number of bytes copied
     */
    static Long copyStream(Stream from, Stream to, Long bytes = -1) async;

    /*! @brief Bidirectional copy stream data until there is no data in the stream, or the stream is closed
     @param stm1 Stream object one
     @param stm2 Stream object two
     */
    static bridge(Stream stm1, Stream stm2) async;
};