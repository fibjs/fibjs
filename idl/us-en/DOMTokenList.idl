/*! @brief DOMTokenList object representing a set of space-separated tokens, commonly used for classList property

 DOMTokenList is an interface representing a set of space-separated tokens. It can be used to represent a CSS class list.

 Example:
 ```JavaScript
 var xml = require('xml');
 var doc = xml.parse('<div class="foo bar"></div>', 'text/html');
 var div = doc.documentElement;
 var classList = div.classList;
 console.log(classList.length); // 2
 console.log(classList.item(0)); // "foo"
 console.log(classList.contains("bar")); // true
 classList.add("baz");
 console.log(div.className); // "foo bar baz"
 ```
 */
interface DOMTokenList : object
{
    /*! @brief Returns the token at the specified index */
    readonly String operator[];

    /*! @brief Returns the number of tokens in the collection */
    readonly Integer length;

    /*! @brief Returns a string representation of all tokens in the collection, separated by spaces */
    readonly String value;

    /*! @brief Returns the token at the specified index
     @param index The index of the token
     @return Returns the token string, or null if the index is out of range
     */
    String item(Integer index);

    /*! @brief Checks if the collection contains the specified token
     @param token The token to check
     @return Returns true if the token is present, false otherwise
     */
    Boolean contains(String token);

    /*! @brief Adds one or more tokens to the collection
     @param tokens The tokens to add, variable arguments
     */
    add(...tokens);

    /*! @brief Removes one or more tokens from the collection
     @param tokens The tokens to remove, variable arguments
     */
    remove(...tokens);

    /*! @brief Toggles a token: removes it if present, adds it if absent
     @param token The token to toggle
     @param force Optional. If true, only adds the token; if false, only removes it
     @return Returns true if the token is present after the operation, false otherwise
     */
    Boolean toggle(String token, ...force);

    /*! @brief Replaces an existing token with a new one
     @param oldToken The token to replace
     @param newToken The new token
     @return Returns true if the replacement was successful, false otherwise
     */
    Boolean replace(String oldToken, String newToken);

    /*! @brief Returns a string representation of all tokens in the collection, separated by spaces
     @return Returns the token string
     */
    String toString();
};
