/*! @brief TLS server object, convenient for creating a standard multi-fiber TLS/SSL server

TLSServer object is a combined encapsulation of TcpServer and TLSHandler, convenient for quickly building servers, logically equivalent to:
 ```JavaScript
 var svr = new net.TLSServer(addr, port, new tls.Handler(ctx, function(conn){
    ...
 }));
 ```

 Creation method:
 ```JavaScript
 var tls = require("tls");
 var svr = new tls.Server(ctx, function(conn){
     ...
 });
 ```
 */
interface TLSServer : TcpServer
{
    /*! @brief Create a new TLSServer object
     @param context Specify the secure context used to create the TLSServer
     @param port Specify the port to listen on
     @param listener Event handler interface object
     */
    TLSServer(SecureContext context, Integer port, Handler listener);

    /*! @brief Create a new TLSServer object
     @param context Specify the secure context used to create the TLSServer
     @param addr Specify the address to listen on
     @param port Specify the port to listen on
     @param listener Event handler interface object
     */
    TLSServer(SecureContext context, String addr, Integer port, Handler listener);

    /*! @brief Create a new TLSServer object

     In addition to the properties used to create SecureContext, options also need to provide the following properties:
     - address: Specify the address to listen on, optional, default listen on all addresses
     - port: Specify the port to listen on, must be provided

     @param options Options needed to create secure context using tls.createSecureContext
     @param listener Event handler interface object
     */
    TLSServer(Object options, Handler listener);

    /*! @brief Create a new TLSServer object, no port — call listen() to bind and start
     @param context Specify the secure context used to create the TLSServer
     @param listener Event handler interface object
     */
    TLSServer(SecureContext context, Handler listener);

    /*! @brief Query the SecureContext used by the current TLSServer */
    readonly SecureContext secureContext;

    /*! @brief Set the SecureContext used by the current TLSServer
    @param context Specify the new SecureContext
    */
    setSecureContext(SecureContext context);

    /*! @brief Set the SecureContext used by the current TLSServer
    @param options Options needed to create secure context using tls.createSecureContext
    */
    setSecureContext(Object options);
};