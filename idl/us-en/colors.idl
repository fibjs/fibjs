/*! @brief Color module

    The color module provides a set of color constants for setting console output colors.
*/
module colors
{
    /*! @brief Whether color output is supported */
    static readonly Boolean hasColors;

    /*! @brief Clear color */
    static readonly String clear;

    /*! @brief Default color */
    static readonly String normal;

    /*! @brief Black */
    static readonly String black;

    /*! @brief Gray */
    static readonly String gray;

    /*! @brief Red */
    static readonly String red;

    /*! @brief Green */
    static readonly String green;

    /*! @brief Yellow */
    static readonly String yellow;

    /*! @brief Blue */
    static readonly String blue;

    /*! @brief Magenta */
    static readonly String magenta;

    /*! @brief Cyan */
    static readonly String cyan;

    /*! @brief White */
    static readonly String white;

    /*! @brief Light red */
    static readonly String lightred;

    /*! @brief Light green */
    static readonly String lightgreen;

    /*! @brief Light yellow */
    static readonly String lightyellow;

    /*! @brief Light blue */
    static readonly String lightblue;

    /*! @brief Light magenta */
    static readonly String lightmagenta;

    /*! @brief Light cyan */
    static readonly String lightcyan;

    /*! @brief Light white */
    static readonly String lightwhite;

    /*! @brief Bold */
    static readonly String bold;
};