/*! @brief Crypto module common constants definition module

 Reference method:
 ```JavaScript
 var constants = require('crypto').constants
 ```
 */
module crypto_constants
{
    /*! @brief PKCS#1 padding method, the most commonly used RSA padding method */
    const RSA_PKCS1_PADDING = 1;

    /*! @brief No padding, raw RSA encryption method */
    const RSA_NO_PADDING = 3;

    /*! @brief PKCS#1 OAEP padding method, provides more secure encryption */
    const RSA_PKCS1_OAEP_PADDING = 4;

    /*! @brief X9.31 padding method */
    const RSA_X931_PADDING = 5;

    /*! @brief PKCS#1 PSS padding method, used for digital signatures */
    const RSA_PKCS1_PSS_PADDING = 6;

    /*! @brief PSS padding uses digest length as salt length */
    const RSA_PSS_SALTLEN_DIGEST = -1;

    /*! @brief PSS padding uses maximum possible length as salt length */
    const RSA_PSS_SALTLEN_MAX_SIGN = -2;

    /*! @brief PSS padding automatically determines salt length */
    const RSA_PSS_SALTLEN_AUTO = -2;
};