/*! @brief Blob objects are used to represent immutable raw data blocks, compatible with the Web standard Blob API.

Blob can be used to store binary data, text, images, etc., commonly used in file upload, data processing, etc. Blob supports concatenation, slicing, and reading of multiple data types, widely used in Web, HTTP, file system, etc. modules.

Main features:
1. Supports flexible construction through arrays and option objects, data types can be strings, ArrayBuffer, TypedArray, Blob, etc.
2. Supports read-only properties like type and size, convenient for getting data type and size.
3. Supports efficient slicing with slice method, supports type conversion.
4. Supports asynchronous reading as text or binary.

Common usage examples:
```JavaScript
// Create empty Blob
const blob = new Blob();

// Create Blob containing string and binary
const blob = new Blob(["hello", new Uint8Array([1,2,3])], { type: "text/plain" });

// Slice
const part = blob.slice(0, 5);

// Read text content
blob.text().then(txt => console.log(txt));

// Read binary content
blob.arrayBuffer().then(buf => ...);
```
 */
interface Blob : object
{
    /*! @brief Blob object constructor
        
     Create a new Blob instance, can specify data content and type.
     @param blobParts Initialization data array, can contain strings, ArrayBuffer, TypedArray, Blob, etc.
     @param options Option object, containing type (MIME type) and endings (line ending handling) properties
    */
    Blob(Array blobParts = [], Object options = {});

    /*! @brief Blob object constructor
        
     Create a new Blob instance, can specify data content and type.
     @param blobData Initialized binary data, can be Buffer or other binary data types
     @param options Option object, containing type (MIME type) and endings (line ending handling) properties
    */
    Blob(Buffer blobData, Object options = {});

    /*! @brief Blob object type, returns the MIME type of the Blob (such as "text/plain", "image/png", etc.), read-only property.
    */
    readonly String type;

    /*! @brief Blob object size, returns the number of bytes of Blob data, read-only property.
    */
    readonly Integer size;

    /*! @brief Return the Blob slice of the specified range
        
     Create a new Blob containing the specified range content of the original data.

     @param start Start position (bytes, default 0)
     @param end End position (bytes, default -1, meaning to the end)
     @param contentType MIME type of the new Blob (optional)
     @return Return new Blob object
    */
    Blob slice(Integer start = 0, Integer end = -1, String contentType = "");

    /*! @brief Read Blob content as text
        
     Asynchronously read Blob data as string, return Promise.
     @return Return Promise containing text content
    */
    String text() promise;

    /*! @brief Read Blob content as ArrayBuffer
        
     Asynchronously read Blob data as ArrayBuffer, return Promise.
     @return Return Promise containing binary data
    */
    ArrayBuffer arrayBuffer() promise;
};