/*! @brief The http module encapsulates the processing of HTTP requests and responses, allowing us to easily create an http server, or simulate a client to initiate http requests. Using the http module, developers can easily write and handle HTTP protocol related code

Below is a simple example, create a Web server, return a hello world response message:

```JavaScript
const http = require('http');

const server = new http.Server(8080, function(request) {
  request.response.write('Hello World!');
});

server.start();
```

In this example, we introduce the http module, then define an http server object, and bind it to the local port 8080. When a request is sent to this port number, the response will be set to the string "Hello World!".

At the same time, the http module also contains client objects, http.Client simulates the browser environment to cache cookies, and carries the corresponding cookies when accessing urls. You can use http.Client to access http interface requests, perform http downloads, and a series of http related operations. Below is an application example of http.Client:

```JavaScript
var http = require('http');

var httpClient = new http.Client();
httpClient.get('http://fibjs.org');
```

In the above example, an http.Client object is created, and then the `get` method is called to initiate an http GET request to fibjs.org.

In addition, http.Client has other properties and methods that can be called, such as `cookies`, etc.

The https module is an alias for the http module, using `require('https')` can also get the http module.
*/
module http
{
    /*! @brief Create an http request object, see HttpRequest */
    static Request = HttpRequest;

    /*! @brief Node.js compatible alias, equivalent to HttpRequest */
    static IncomingMessage = HttpRequest;

    /*! @brief Create an http response object, see HttpResponse */
    static Response = HttpResponse;

    /*! @brief Node.js compatible alias, equivalent to HttpResponse */
    static ServerResponse = HttpResponse;

    /*! @brief Create a Headers object, see Headers */
    static Headers;

    /*! @brief Create an http cookie object, see HttpCookie */
    static Cookie = HttpCookie;

    /*! @brief Create an http server, see HttpServer */
    static Server = HttpServer;

    /*! @brief Create an http client, see HttpClient */
    static Client = HttpClient;

    /*! @brief Create an http agent, see HttpClient */
    static Agent = HttpClient;

    /*! @brief Create an https server, see HttpsServer */
    static HttpsServer = HttpsServer;

    /*! @brief Create an http server
     @param hdlr Request handler function, receives (req, res) parameters
     @return Return an unbound HttpServer object, call listen() to start
     */
    static HttpServer createServer(Handler hdlr);

    /*! @brief Create an https server
     @param context SecureContext object for TLS configuration
     @param hdlr Request handler function, receives (req, res) parameters
     @return Return an unbound HttpsServer object, call listen() to start
     */
    static HttpServer createServer(SecureContext context, Handler hdlr);

    /*! @brief Create an https server
     @param options TLS options object, used to create SecureContext
     @param hdlr Request handler function, receives (req, res) parameters
     @return Return an unbound HttpsServer object, call listen() to start
     */
    static HttpServer createServer(Object options, Handler hdlr);

    /*! @brief Create an http protocol handler object, see HttpHandler */
    static Handler = HttpHandler;

    /*! @brief Create an http request forwarding handler object, see HttpRepeater */
    static Repeater = HttpRepeater;

    /*! @brief Return the collection of standard HTTP response status codes, and their short descriptions. */
    static readonly Object STATUS_CODES;

    /*! @brief Return an array of the HTTP method names (uppercase) supported by the Node.js HTTP module. */
    static readonly Array METHODS;

    /*! @brief Return the HttpCookie object list of the http client */
    static readonly NArray cookies;

    /*! @brief Query and set whether to keep connection */
    static Boolean keepAlive;

    /*! @brief Query and set timeout time */
    static Integer timeout;

    /*! @brief Cookie function switch, enabled by default */
    static Boolean enableCookie;

    /*! @brief Auto redirect function switch, enabled by default */
    static Boolean autoRedirect;

    /*! @brief Auto decompression function switch, enabled by default */
    static Boolean enableEncoding;

    /*! @brief HTTP/2 auto-upgrade switch, disabled by default */
    static Boolean enableH2;

    /*! @brief Query and set the maximum number of request headers, default is 128 */
    static Integer maxHeadersCount;

    /*! @brief Query and set the maximum request header length, default is 8192 */
    static Integer maxHeaderSize;

    /*! @brief Query and set the maximum chunk size in MB, default is 2 */
    static Integer maxChunkSize;

    /*! @brief Query and set the maximum body size in MB, default is -1, no size limit */
    static Integer maxBodySize;

    /*! @brief Query and set the browser identifier in http request */
    static String userAgent;

    /*! @brief Query and set the keep-alive cached connection timeout time, default 10000 ms */
    static Integer poolTimeout;

    /*! @brief Query and set the maximum number of free sockets per host, default 256 */
    static Integer maxFreeSockets;

    /*! @brief Create an http static file handler to respond to http messages with static files

     fileHandler supports gzip pre-compression, when the request accepts gzip encoding, and filename.ext.gz file exists in the same path, it will directly return this file,
     thereby avoiding the server load caused by repeated compression.
     @param root File root path
     @param autoIndex Whether to support browsing directory files, default is false, not supported
     @return Return a static file handler for processing http messages
     */
    static Handler fileHandler(String root, Boolean autoIndex = false);

    /*! @brief Send http request to the specified stream object and return the result
     @param conn Specify the stream object that handles the request
     @param req The HttpRequest object to send
     @return Return server response
     */
    static HttpRequest request(Stream conn, HttpRequest req);

    /*! @brief Request the specified url and return the result
     opts contains additional options for the request, supports the following content:
     ```JavaScript
     {
         "method": "GET", // specify the http request method: GET, POST, etc, default: GET.
         "protocol": "http",
         "slashes": true,
         "username": "",
         "password": "",
         "hostname": "",
         "port": "",
         "pathname": "",
         "path": "", // Node.js compatible alias of pathname for request options.
         "keepAlive": unknown, // If not specified, the default settings of the client will be used.
         "query": {},
         "body": SeekableStream | Buffer | String | {},
         "json": {},
         "pack": {},
         "headers": {}
     }
     ```
     body, json, pack must not appear at the same time. Default is {}, no additional information
     @param method Specify http request method: GET, POST, etc
     @param url Specify url, must be a complete url containing the host
     @param opts Specify additional information
     @return Return server response
     */
    static HttpResponse requestSync(String method, String url, Object opts = {}) async;

    /*! @brief Request the url specified by opts and return the result
     opts contains additional options for the request, supports the following content:
     ```JavaScript
     {
         "method": "GET", // specify the http request method: GET, POST, etc, default: GET.
         "protocol": "http",
         "slashes": true,
         "username": "",
         "password": "",
         "hostname": "",
         "port": "",
         "pathname": "",
         "keepAlive": unknown, // If not specified, the default settings of the client will be used.
         "query": {},
         "body": SeekableStream | Buffer | String | {},
         "json": {},
         "pack": {},
         "headers": {}
     }
     ```
     body, json, pack must not appear at the same time. Default is {}, no additional information
     @param opts Specify additional information
     @return Return server response
     */
    static HttpResponse requestSync(Object opts) async;

    /*! @brief Request the specified url with GET method and return the result, equivalent to request("GET", ...)
     opts contains additional options for the request, supports the following content:
     ```JavaScript
     {
         "method": "GET", // specify the http request method: GET, POST, etc, default: GET.
         "protocol": "http",
         "slashes": true,
         "username": "",
         "password": "",
         "hostname": "",
         "port": "",
         "pathname": "",
         "keepAlive": unknown, // If not specified, the default settings of the client will be used.
         "query": {},
         "body": SeekableStream | Buffer | String | {},
         "json": {},
         "pack": {},
         "headers": {}
     }
     ```
     body, json, pack must not appear at the same time. Default is {}, no additional information
     @param url Specify url, must be a complete url containing the host
     @param opts Specify additional information
     @return Return server response
     */
    static HttpResponse requestSync(String url, Object opts = {}) async;

    /*! @brief Request the specified url, register callback to receive response, return HttpRequest object
     opts contains additional options for the request, supports the following content:
     ```JavaScript
     {
         "method": "GET", // specify the http request method: GET, POST, etc, default: GET.
         "protocol": "http",
         "slashes": true,
         "username": "",
         "password": "",
         "hostname": "",
         "port": "",
         "pathname": "",
         "path": "", // Node.js compatible alias of pathname for request options.
         "keepAlive": unknown, // If not specified, the default settings of the client will be used.
         "timeout": 0, // request timeout in milliseconds, defaults to client setting
         "query": {},
         "body": SeekableStream | Buffer | String | {},
         "json": {},
         "pack": {},
         "headers": {},
         "signal": AbortSignal // AbortSignal object for cancelling the request
     }
     ```
     body, json, pack must not appear at the same time. Default is {}, no additional information
     @param method Specify http request method: GET, POST, etc
     @param url Specify url, must be a complete url containing the host
     @param opts Specify additional information
     @return Return HttpRequest object (listen 'response' event to receive the response)
     */
    static HttpRequest request(String method, String url, Object opts = {});

    /*! @brief Request the url specified by opts and return HttpRequest object
     opts contains additional options for the request, supports the following content:
     ```JavaScript
     {
         "method": "GET", // specify the http request method: GET, POST, etc, default: GET.
         "protocol": "http",
         "slashes": true,
         "username": "",
         "password": "",
         "hostname": "",
         "port": "",
         "pathname": "",
         "keepAlive": unknown, // If not specified, the default settings of the client will be used.
         "timeout": 0, // request timeout in milliseconds, defaults to client setting
         "query": {},
         "body": SeekableStream | Buffer | String | {},
         "json": {},
         "pack": {},
         "headers": {},
         "signal": AbortSignal // AbortSignal object for cancelling the request
     }
     ```
     body, json, pack must not appear at the same time. Default is {}, no additional information
     @param opts Specify additional information
     @return Return HttpRequest object (listen 'response' event to receive the response)
     */
    static HttpRequest request(Object opts);

    /*! @brief Request the specified url and return HttpRequest object
     opts contains additional options for the request, supports the following content:
     ```JavaScript
     {
         "method": "GET", // specify the http request method: GET, POST, etc, default: GET.
         "protocol": "http",
         "slashes": true,
         "username": "",
         "password": "",
         "hostname": "",
         "port": "",
         "pathname": "",
         "keepAlive": unknown, // If not specified, the default settings of the client will be used.
         "timeout": 0, // request timeout in milliseconds, defaults to client setting
         "query": {},
         "body": SeekableStream | Buffer | String | {},
         "json": {},
         "pack": {},
         "headers": {},
         "signal": AbortSignal // AbortSignal object for cancelling the request
     }
     ```
     body, json, pack must not appear at the same time. Default is {}, no additional information
     @param url Specify url, must be a complete url containing the host
     @param opts Specify additional information
     @return Return HttpRequest object (listen 'response' event to receive the response)
     */
    static HttpRequest request(String url, Object opts = {});

    /*! @brief Request the specified url, register callback to receive response, return HttpRequest object
     @param method Specify http request method: GET, POST, etc
     @param url Specify url, must be a complete url containing the host
     @param opts Specify additional information
     @param callback Response callback function, receives HttpResponse as parameter
     @return Return HttpRequest object
     */
    static HttpRequest request(String method, String url, Object opts, Function callback);

    /*! @brief Request the url specified by opts, register callback to receive response, return HttpRequest object
     @param opts Specify additional information
     @param callback Response callback function, receives HttpResponse as parameter
     @return Return HttpRequest object
     */
    static HttpRequest request(Object opts, Function callback);

    /*! @brief Request the specified url, register callback to receive response, return HttpRequest object
     @param url Specify url, must be a complete url containing the host
     @param opts Specify additional information
     @param callback Response callback function, receives HttpResponse as parameter
     @return Return HttpRequest object
