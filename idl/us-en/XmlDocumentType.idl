/*! @brief XmlDocumentType object is used to access entities defined in XML
*/
interface XmlDocumentType : XmlNode
{
    /*! @brief Return the name of the DTD
	*/
    readonly String name;

    /*! @brief Can return the public identifier of the external DTD
	*/
    readonly String publicId;

    /*! @brief Can return the system identifier of the external DTD
	*/
    readonly String systemId;
};