/*! @brief Basic module management */
module module
{
    /*!@brief Create a module reference function
     @param base Base path of the module
     @return Return a module reference function
    */
    static Function createRequire(String base);

    /*!@brief List of built-in module names
     List of built-in module names, compatible with Node.js. Contains all fibjs built-in module names, including versions with the node: prefix.
    */
    static readonly Array builtinModules;

    /*!@brief Enable module compile cache
     Node.js v22.8+ compatible interface, no-op in fibjs. In Node.js, this method caches V8 compiled bytecode to disk to speed up subsequent startup.
     @param cacheDir Cache directory path, optional
     @return Returns an object with status and message, status 2 means not supported
    */
    static Object enableCompileCache(String cacheDir = "");
};