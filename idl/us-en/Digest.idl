/*! @brief Message digest object 

You can use the Digest object like this:

```
const crypto = require('crypto');
// create a SHA-512 digest object
const digest = crypto.createHash('sha512');
// update digest with data
digest.update('hello');
digest.update('world');
// get digest result
const result = digest.digest();
console.log(result);

// output result in hex and base64
console.log(result.toString('hex'));
console.log(result.toString('base64'));
```
In the above code, a SHA-512 digest operation object is created using the `crypto.createHash()` method, data to be digested can be added step by step through the `update()` method, and the digest result can be obtained through the `digest()` method.
*/
interface Digest : object
{
    /*! @brief Update binary digest information
     @param data Binary data block
     @return Return the message digest object itself
     */
    Digest update(Buffer data);

    /*! @brief Update string digest information
     @param data String data
     @param codec Specify encoding format, allowed values: "buffer", "hex", "base32", "base58", "base64", "utf8", or character sets supported by the iconv module
     @return Return the message digest object itself
     */
    Digest update(String data, String codec = "utf8");

    /*! @brief Calculate and return the digest
     @param codec Specify encoding format, allowed values: "buffer", "hex", "base32", "base58", "base64", "utf8", or character sets supported by the iconv module
     @return Return the digest representation of the specified encoding
     */
    Value digest(String codec = "buffer");

    /*! @brief Query the digest byte count of the current message digest algorithm */
    readonly Integer size;
};