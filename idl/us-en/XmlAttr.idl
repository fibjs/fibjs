/*! @brief XmlAttr object represents an attribute of an XmlElement object */
interface XmlAttr : object
{
    /*! @brief Query the local name of the element. If the selected node has no namespace, this attribute is equivalent to nodeName
    */
    readonly String localName;

    /*! @brief The value of the attribute
    */
    String value;

    /*! @brief The name of the attribute
    */
    readonly String name;

    /*! @brief Query the URI of the element's namespace. If the selected node has no namespace, this attribute returns NULL
    */
    readonly String namespaceURI;

    /*! @brief Query and set the namespace prefix of the element. If the selected node has no namespace, this attribute returns NULL
    */
    String prefix;

    /*! @brief The name of the attribute, for compatibility purposes
    */
    readonly String nodeName;

    /*! @brief The value of the attribute, for compatibility purposes
    */
    String nodeValue;

    /*! @brief Copy the XmlAttr object
    @return Returns a copy of the XmlAttr object
    */
    XmlAttr cloneNode();
};