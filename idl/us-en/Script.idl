/*! @brief Script script compilation and execution object

 Creation method
 ```JavaScript
 var Script = new vm.Script('console.log(100)');
 ```
 */
interface Script : object
{
    /*! @brief Script object constructor
     @param code Specify the script code to compile and run
     @param opts Specify compilation and execution options
    */
    Script(String code, Object opts = {});

    /*! @brief Run the compiled code contained in the vm.Script object within the given contextifiedObject and return the result
     @param contextifiedObject Specify the context object at runtime
     @param opts Specify execution options
     @return Return the execution result
    */
    Value runInContext(Object contextifiedObject, Object opts = {});

    /*! @brief Using the given contextObject in the created context, run the compiled code contained in the vm.Script object within it and return the result
     @param contextObject Specify the object to be contextified
     @param opts Specify execution options
     @return Return the execution result
    */
    Value runInNewContext(Object contextObject = {}, Object opts = {});

    /*! @brief Run the compiled code contained in the vm.Script object within the current context and return the result
     @param opts Specify execution options
     @return Return the execution result
    */
    Value runInThisContext(Object opts = {});

    /*! @brief Create code cache based on the current Script object
     @return Return code cache data
    */
    Buffer createCachedData();
};