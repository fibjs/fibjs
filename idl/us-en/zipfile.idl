/*! @brief ZipFile object is an important object in the zip format file compression and decompression module, providing read and write access to zip files

ZipFile object inherits from Stream object, so it can be operated in the same way as Stream object.

Common static functions include:

- zip.open: open a zip file or stream
- zip.isZipFile: determine if the file is a zip file
- fs.setZipFS: set zip file virtual file system
- fs.clearZipFS: clear zip file virtual file system

Common instance functions and methods of ZipFile object include:

- NArray ZipFile.namelist(): get file name list
- NObject ZipFile.getinfo(String member): get file information
- Buffer ZipFile.read(String member, String password = ""): read specified file
- NArray ZipFile.readAll(String password = ""): read all files
- void ZipFile.extract(String member, String path, String password = ""): extract file to specified path
- void ZipFile.extract(String member, SeekableStream strm, String password = ""): extract file to stream
- void ZipFile.extractAll(String path, String password = ""): extract all files to specified path
- void ZipFile.write(String filename, String inZipName, String password = ""): write specified file to compressed file
- void ZipFile.write(Buffer data, String inZipName, String password = ""): write specified file to compressed file
- void ZipFile.write(SeekableStream strm, String inZipName, String password = ""): write specified file to compressed file
- void ZipFile.close(): close the opened zip file

Code example as follows:

```JavaScript
var zip = require('zip');
var path = require('path');
var fs = require('fs');

var zipfile = zip.open(path.join(__dirname, 'unzip_test.zip' ), 'w');

// write a file
var buf = new Buffer('test data');
zipfile.write(buf, 'test.txt');

// read a file
buf = zipfile.read("unzip_test.js");
console.log(buf);

zipfile.close();
``` */
interface ZipFile : object
{
    /*! @brief Get file name list
	 @return Return the list object containing file names
	 */
    NArray namelist() async;

    /*! @brief Get file information list 
	 File information includes fields: filename, date, compress_type, compress_size, file_size, password, data
	 @return Return the list object containing file information
	 */
    NArray infolist() async;

    /*! @brief Get file information
	 File information includes fields: filename, date, compress_type, compress_size, file_size, password, data
	 @param member Specify the file name to get information
	 @return Return the file information object
	*/
    NObject getinfo(String member) async;

    /*! @brief Return the data read from the compressed file
	 @param member Specify the file name to read
	 @param password Decompression password, default no password
	 @return Return all data of the file
	 */
    Buffer read(String member, String password = "") async;

    /*! @brief Extract all files
	 @param password Decompression password, default no password
	 @return List containing all file data and information
     */
    NArray readAll(String password = "") async;

    /*! @brief Extract specified file
	 @param member Specify the file name to extract
	 @param path Specify the path to extract to
	 @param password Decompression password, default no password
	 */
    extract(String member, String path, String password = "") async;

    /*! @brief Extract specified file to stream
	 @param member Specify the file name to extract
	 @param strm Specify the stream to extract to
	 @param password Decompression password, default no password
	 */
    extract(String member, SeekableStream strm, String password = "") async;

    /*! @brief Extract all files to specified path
	 @param path Specify the path to extract to
	 @param password Decompression password, default no password
	 */
    extractAll(String path, String password = "") async;

    /*! @brief Write specified file to compressed file
	 @param filename Specify the file to write
	 @param inZipName The file name compressed in the zip file
	 @param password Decompression password, default no password
	 */
    write(String filename, String inZipName, String password = "") async;

    /*! @brief Write specified file to compressed file
	 @param data Specify the file data to write
	 @param inZipName The file name compressed in the zip file
	 @param password Decompression password, default no password
	 */
    write(Buffer data, String inZipName, String password = "") async;

    /*! @brief Write specified file to compressed file
	 @param strm Specify the file data stream to write
	 @param inZipName The file name compressed in the zip file
	 @param password Decompression password, default no password
	 */
    write(SeekableStream strm, String inZipName, String password = "") async;

    /*! @brief Close the opened zip file */
    close() async;
};