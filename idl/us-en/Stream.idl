/*! @brief Stream operation object for binary data stream read and write

Stream is a base object used to define standard interfaces for stream processing, cannot be created independently */
interface Stream : EventEmitter
{
    /*! @brief Query the file descriptor value corresponding to the Stream, implemented by subclasses */
    readonly Integer fd;

    /*! @brief Read data of specified size from the stream
     @param bytes Specifies the amount of data to read, default is to read a random size data block, the size of the read data depends on the device
     @return Returns the data read from the stream. If encoding is set, returns a string; otherwise returns a Buffer. Returns null if no data is available or the connection is interrupted
     */
    Variant read(Integer bytes = -1) async;

    /*! @brief Read data of specified size from the stream as Buffer
     @param bytes Specifies the amount of data to read, default is to read a random size data block, the size of the read data depends on the device
     @return Returns the Buffer data read from the stream, returns null if no data is available or the connection is interrupted
     */
    Buffer readBuffer(Integer bytes = -1) async;

    /*! @brief Set the encoding for the stream. After setting, read() will return strings instead of Buffer objects
     @param encoding The encoding to use, e.g. 'utf8', 'ascii', 'hex', etc. Pass null to return to Buffer mode
     @return Returns the current stream object
     */
    Stream setEncoding(String encoding);

    /*! @brief Write the given binary data to the stream
     @param data The Buffer data to write
     */
    writeBuffer(Buffer data) async;

    /*! @brief Write the given data to the stream
     @param data The data to write
     @return Returns true if the stream wishes for the calling code to wait for the 'drain' event to be emitted before continuing to write additional data; otherwise false
     */
    Boolean write(Buffer data) async;

    /*! @brief Write the given data to the stream
     @param data The data to write
     @param encoding The specified encoding method, since data is Buffer type, this parameter will be ignored
     @return Returns true if the stream wishes for the calling code to wait for the 'drain' event to be emitted before continuing to write additional data; otherwise false
     */
    Boolean write(Buffer data, String encoding) async;

    /*! @brief Write the given string to the stream
     @param data The string data to write
     @param encoding Specifies the encoding method of the string, default is "utf8"
     @return Returns true if the stream wishes for the calling code to wait for the 'drain' event to be emitted before continuing to write additional data; otherwise false
     */
    Boolean write(String data, String encoding = "utf8") async;

    /*! @brief Switch the stream to flowing read mode. In fibjs, switching to flowing read mode is irreversible, cannot switch back to non-flowing read mode.
     @return Returns the current stream object
     */
    Stream resume();

    /*! @brief Pause the stream's automatic read mode. This method is only for compatibility, calling it currently has no effect
     @return Returns the current stream object
     */
    Stream pause();

    /*! @brief End the stream operation, optionally write the final data
     @return Returns an asynchronous object
     */
    Integer end() async;

    /*! @brief Write the given file buffer to the stream and end the stream operation
     @param data The file buffer data to write
     @return Returns an asynchronous object
     */
    Integer end(Buffer data) async;

    /*! @brief Write the given file buffer to the stream and end the stream operation
     @param data The file buffer data to write
     @param encoding The specified encoding method, since data is Buffer type, this parameter will be ignored
     @return Returns an asynchronous object
     */
    Integer end(Buffer data, String encoding) async;

    /*! @brief Write the given string to the stream and end the stream operation
     @param data The string data to write
     @param encoding Specifies the encoding method of the string, default is "utf8"
     @return Returns an asynchronous object
     */
    Integer end(String data, String encoding = "utf8") async;

    /*! @brief Write the file buffer content to the physical device */
    flush() async;

    /*! @brief Close the current stream object */
    close() async;

    /*! @brief Copy stream data to the target stream
     @param stm The target stream object
     @param bytes The number of bytes to copy
     @return Returns the number of bytes copied
     */
    Long copyTo(Stream stm, Long bytes = -1) async;

    /*! @brief Query and bind stream data event, equivalent to on("data", func);
     @param data The data read
     */
    event data(Buffer data);

    /*! @brief Query and bind stream close event, equivalent to on("close", func); */
    event close();

    /*! @brief Query and bind stream error event, equivalent to on("error", func);
     @param code The error code
     */
    event error(Integer code);

    /*! @brief Keep the fibjs process from exiting, prevent fibjs process from exiting during object binding
     @return Returns the current object
    */
    Stream ref();

    /*! @brief Allow the fibjs process to exit, allow fibjs process to exit during object binding
     @return Returns the current object
    */
    Stream unref();
};