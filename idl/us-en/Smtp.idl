/*! @brief Smtp object

 */
interface Smtp : object
{
    /*! @brief Smtp object constructor */
    Smtp();

    /*! @brief Establish connection to specified server
     @param url Specify the protocol for connection, can be: tcp://host:port or ssl://host:port
     */
    connect(String url) async;

    /*! @brief Send specified command and return response, throw error if server reports error
     @param cmd Command name
     @param arg Parameter
     @return If successful, return server response
     */
    String command(String cmd, String arg) async;

    /*! @brief Send HELO command, throw error if server reports error
     @param hostname Hostname, default is "localhost"
     */
    hello(String hostname = "localhost") async;

    /*! @brief Login to server with specified user and password, throw error if server reports error
     @param username Username
     @param password Password
     */
    login(String username, String password) async;

    /*! @brief Specify sender mailbox, throw error if server reports error
     @param address Sender mailbox
     */
    from(String address) async;

    /*! @brief Specify recipient mailbox, throw error if server reports error
     @param address Recipient mailbox
     */
    to(String address) async;

    /*! @brief Send text to recipient, throw error if server reports error
     @param txt Text to send
     */
    data(String txt) async;

    /*! @brief Quit and close connection, throw error if server reports error */
    quit() async;

    /*! @brief Query and set timeout time in milliseconds*/
    Integer timeout;

    /*! @brief Query the Socket currently connected by Smtp object */
    readonly Stream socket;
};