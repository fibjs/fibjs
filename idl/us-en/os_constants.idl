/*! @brief os module constants object

 Usage:
 ```JavaScript
 var constants = require('os').constants
 ```
 */
module os_constants
{
    /*! @brief UDP address reuse flag */
    const UV_UDP_REUSEADDR = 4;

    /*! @brief errno error code constants sub-object */
    static errno = os_constants_errno;

    /*! @brief signal constants sub-object */
    static signals = os_constants_signals;

    /*! @brief process priority constants sub-object */
    static priority = os_constants_priority;

    /*! @brief dynamic linker flags constants sub-object */
    static dlopen = os_constants_dlopen;
};
