/*! @brief http2 module provides HTTP/2 protocol support

The http2 module allows creating HTTP/2 servers and clients with full protocol support including stream multiplexing, header compression, and flow control.

```JavaScript
const http2 = require('http2');

// Client example
const session = http2.connect('https://example.com');
const stream = session.request({ ':path': '/' });
const response = stream.read();
session.close();

// Server example
const server = http2.createServer({
    key: ...,
    cert: ...
}, function(req) {
    req.response.write('Hello, HTTP/2!');
});
server.listen(8443);
server.start();
```
*/
module http2
{
    /*! @brief Create an Http2Server object, see Http2Server */
    static Http2Server new Server();

    /*! @brief Create an Http2 server
     @param options TLS options object or SecureContext configuration
     @param hdlr Request handler function
     @return Return Http2Server object, call listen() then start() to begin serving
    */
    static Http2Server createServer(Object options, Handler hdlr);

    /*! @brief Create an Http2 server
     @param context SecureContext object for TLS configuration
     @param hdlr Request handler function
     @return Return Http2Server object, call listen() then start() to begin serving
    */
    static Http2Server createServer(SecureContext context, Handler hdlr);

    /*! @brief Create an HTTP/2 client session to the specified authority

     The authority should be a URL string like 'https://example.com' or 'https://example.com:8443'.

     Options may include:
     - All SecureContext options (key, cert, ca, etc.)

     @param authority The server URL to connect to
     @param options Connection options
     @return Return an Http2Session client session
    */
    static Http2Session connect(String authority, Object options = {}) async;

    /*! @brief Return the default HTTP/2 settings object
     @return Return Object containing default settings
    */
    static Object getDefaultSettings();

    /*! @brief Http2Stream object, see Http2Stream */
    static Http2Stream;

    /*! @brief Http2Session object, see Http2Session */
    static Http2Session;

    /*! @brief Constants object of http2 module, see http2_constants */
    static http2_constants new constants();
};
