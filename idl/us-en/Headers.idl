/*! @brief Headers is a container class specifically for handling HTTP header information, inheriting from HttpCollection

Headers implements the standard HTTP Headers API, and serves as both the global Headers object and the implementation class for http.Headers. It provides complete HTTP header management functionality, supporting standard HTTP header field operations, inheriting all functions of HttpCollection, including adding, setting, querying, and deleting header fields.

Headers supports the following usage methods:

1. As global Headers API (Web standard):

```JavaScript
// Create empty Headers object
const headers = new Headers();

// Initialize with object
const headers = new Headers({
    'Content-Type': 'application/json',
    'Accept': 'application/json'
});

// Initialize with array
const headers = new Headers([
    ['Content-Type', 'application/json'],
    ['Accept', 'application/json']
]);

// Copy from another Headers object
const copy = new Headers(headers);
```

2. As http.Headers (fibjs extension):

```JavaScript
const headers = new http.Headers({
    'User-Agent': 'fibjs/1.0',
    'Accept': 'text/html'
});
```

Headers API standard method examples:

```JavaScript
// Standard Headers API methods
headers.set('Content-Type', 'text/html; charset=utf-8');
headers.append('Accept', 'application/json');
headers.get('Content-Type');  // 'text/html; charset=utf-8'
headers.has('Accept');        // true
headers.delete('User-Agent');

// Iterator support
for (const [name, value] of headers) {
    console.log(`${name}: ${value}`);
}

// Iterate over keys
for (const name of headers.keys()) {
    console.log(name);
}

// Iterate over values
for (const value of headers.values()) {
    console.log(value);
}

// forEach method
headers.forEach((value, name) => {
    console.log(`${name}: ${value}`);
});
```

fibjs extension method examples (inherited from HttpCollection):

```JavaScript
// Add multiple values (without overwriting existing values)
headers.add('Cache-Control', 'no-cache');

// Get first value
const auth = headers.first('Authorization');

// Get all values
const cookies = headers.all('Set-Cookie');

// Set multiple Cookies
headers.set('Set-Cookie', [
    'sessionId=abc123; Path=/',
    'userId=456; Path=/; HttpOnly'
]);
```

Headers automatically handles the case-insensitive nature of header field names, fully complying with HTTP protocol specifications and Web standard Headers API.
 */
interface Headers : HttpCollection
{
    /*! @brief Headers constructor, creates a new empty HTTP header container */
    Headers();

    /*! @brief Headers constructor, initializes HTTP header container with the given object
     @param init The header field object for initialization, keys are header field names, values are header field values
     */
    Headers(Object init);

    /*! @brief Headers constructor, initializes HTTP header container with the given array
     @param init The header field array for initialization, each element is an array containing header field name and header field value
     */
    Headers(Array init);

    /*! @brief Headers constructor, initializes HTTP header container with the given HTTP header container
     @param init The HTTP header container for initialization
     */
    Headers(Headers init);
};