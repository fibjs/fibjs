/*! @brief Base object, all objects inherit from this*/
interface object
{
    /*! @brief Return the string representation of the object, generally returns "[Native Object]", objects can reimplement according to their own characteristics
     @return Return the string representation of the object
    */
    String toString();

    /*! @brief Return the JSON format representation of the object, generally returns the readable property collection defined by the object
     @param key Not used
     @return Return the value that can be JSON serialized
     */
    Value toJSON(String key = "");
};