/*! @brief URL processing module, providing URL parsing, formatting, file path conversion, and internationalized domain name processing functions

The url module implements complete URL processing functionality, compatible with WHATWG URL standard and traditional Node.js API.
It provides URL objects, URLSearchParams objects, and various practical URL operation functions.

## Main Features

- **URL parsing and formatting**: Supports parsing and formatting various URL formats
- **File URL processing**: Provides conversion between file paths and file:// URLs
- **Internationalized domains**: Supports conversion between ASCII and Unicode domains
- **Query parameter processing**: Integrated URLSearchParams provides powerful query parameter operations
- **Relative path resolution**: Supports parsing and merging of relative URLs

## Basic Usage

### 1. Creating and operating URL objects

```JavaScript
const { URL, URLSearchParams } = require('url');

// Create URL object
const myURL = new URL('https://example.com:8080/path?key=value#hash');

// Access various parts of URL
console.log(myURL.protocol);  // 'https:'
console.log(myURL.hostname);  // 'example.com'
console.log(myURL.port);      // '8080'
console.log(myURL.pathname);  // '/path'
console.log(myURL.search);    // '?key=value'
console.log(myURL.hash);      // '#hash'

// Modify URL
myURL.pathname = '/new-path';
myURL.searchParams.set('new-key', 'new-value');
console.log(myURL.href);      // 'https://example.com:8080/new-path?key=value&new-key=new-value#hash'
```

### 2. Traditional API compatibility

```JavaScript
const url = require('url');

// Parse URL string
const parsed = url.parse('https://example.com/path?key=value#hash');
console.log(parsed.hostname);  // 'example.com'

// Format URL object
const formatted = url.format({
  protocol: 'https:',
  hostname: 'example.com',
  pathname: '/path'
});
console.log(formatted);  // 'https://example.com/path'

// Resolve relative URL
const resolved = url.resolve('https://example.com/foo/', '../bar');
console.log(resolved);   // 'https://example.com/bar'
```

### 3. File URL processing

```JavaScript
const url = require('url');

// Path to file URL
const fileURL = url.pathToFileURL('/path/to/file.txt');
console.log(fileURL.href);  // 'file:///path/to/file.txt'

// File URL to path
const filePath = url.fileURLToPath('file:///path/to/file.txt');
console.log(filePath);      // '/path/to/file.txt'
```

### 4. Internationalized domain name processing

```JavaScript
const url = require('url');

// Unicode domain to ASCII
const ascii = url.domainToASCII('测试.com');
console.log(ascii);         // 'xn--0zwm56d.com'

// ASCII domain to Unicode
const unicode = url.domainToUnicode('xn--0zwm56d.com');
console.log(unicode);       // '测试.com'
```
*/
module url
{
    /*! @brief Format URL string as standard URL string
     @param href URL string
     @return Formatted URL string
     */
    static String format(String href);

    /*! @brief Construct URL string using URL component object
     @param args URL component object, supported fields include: protocol, slashes, username, password, hostname, port, pathname, query, hash
     @return Constructed URL string
     */
    static String format(Object args);

    /*! @brief Format URL object as string, supports formatting options
     @param urlObject URL object to format
     @param options Formatting options, supported fields include: fragment (whether to include fragment), unicode (whether to display domain in Unicode), auth (whether to include authentication information)
     @return Formatted URL string
     */
    static String format(UrlObject urlObject, Object options = {});

    /*! @brief Parse URL string into URL object (traditional API)
     @param url URL string to parse
     @param parseQueryString Whether to parse query string as object, default is false
     @param slashesDenoteHost Whether to parse the string from '//' to the next '/' as host, default is false
     @return Parsed UrlObject object
     */
    static UrlObject parse(String url, Boolean parseQueryString = false, Boolean slashesDenoteHost = false);

    /*! @brief Parse relative URL and merge into absolute URL
     @param _from Base URL string
     @param to Relative URL string to parse
     @return Merged absolute URL string
     */
    static String resolve(String _from, String to);

    /*! @brief Create URL object, see UrlObject
     @return New UrlObject instance
     */
    static URL = UrlObject;

    /*! @brief Create URLSearchParams object, see URLSearchParams
     @return New URLSearchParams instance
     */
    static URLSearchParams = URLSearchParams;

    /*! @brief Convert file URL object to platform-related file path
     @param url File URL object (must be file: protocol)
     @param options Conversion options, supports windows field to specify whether to force Windows path format
     @return Converted file path string
     */
    static String fileURLToPath(UrlObject url, Object options = {});

    /*! @brief Convert file URL string to platform-related file path
     @param url File URL string (must be file: protocol)
     @param options Conversion options, supports windows field to specify whether to force Windows path format
     @return Converted file path string
     */
    static String fileURLToPath(String url, Object options = {});

    /*! @brief Convert file path to file URL object
     @param path File path to convert
     @param options Conversion options, supports windows field to specify whether path is Windows format
     @return Converted file URL object
     */
    static UrlObject pathToFileURL(String path, Object options = {});

    /*! @brief Convert internationalized domain name to ASCII encoding (Punycode)
     @param domain Domain name to convert (can contain Unicode characters)
     @return ASCII encoded domain name
     */
    static String domainToASCII(String domain);

    /*! @brief Convert ASCII encoded domain name to Unicode display format
     @param domain ASCII domain name to convert
     @return Unicode formatted domain name
     */
    static String domainToUnicode(String domain);
};