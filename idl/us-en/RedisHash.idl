/*! @brief Redis database client Hash object, this object contains the client with the specified key, only when calling its methods will operate the database

 Used to operate Redis Hash objects, creation method:
 ```JavaScript
 var db = require("db");
 var rdb = new db.openRedis("redis-server");
 var hash = rdb.getHash("test");
 ```
 */
interface RedisHash : object
{
    /*! @brief Set the value of the field in the hash table to value, if the field already exists in the hash table, the old value will be overwritten
     @param field Specify the field to modify
     @param value Specify the data to modify */
    set(Buffer field, Buffer value);

    /*! @brief Set the value of the field in the hash table to value, only when the field does not exist. If the field already exists, this operation is invalid
     @param field Specify the field to modify
     @param value Specify the data to modify */
    setNX(Buffer field, Buffer value);

    /*! @brief Simultaneously set multiple field-value pairs to the hash table, this command will overwrite existing fields in the hash table
     @param kvs Specify the field/value object to set*/
    mset(Object kvs);

    /*! @brief Simultaneously set multiple field-value pairs to the hash table, this command will overwrite existing fields in the hash table
     @param kvs Specify the field/value list to set*/
    mset(...kvs);

    /*! @brief Return the value of the given field in the hash table
     @param field Specify the field to query
     @return The value of the given field, return null when the given field does not exist or the given key does not exist */
    Buffer get(Buffer field);

    /*! @brief Return the values of one or more given fields in the hash table
     @param fields Specify the field array to query
     @return A list containing the values of all given fields */
    NArray mget(Array fields);

    /*! @brief Return the values of one or more given fields in the hash table
     @param fields Specify the field list to query
     @return A list containing the values of all given fields */
    NArray mget(...fields);

    /*! @brief Add the increment to the value stored in the field
     @param field Specify the field to modify
     @param num Specify the number to add
     @return The value of the field after adding num */
    Long incr(Buffer field, Long num = 1);

    /*! @brief Return all fields and values in the hash table
     @return Return a list containing all fields in the hash table */
    NArray getAll();

    /*! @brief Return all fields in the hash table
     @return In the return value, immediately following each field name is the field value, so the length of the return value is twice the size of the hash table */
    NArray keys();

    /*! @brief Return the number of fields in the hash table
     @return Return the number of fields in the hash table */
    Integer len();

    /*! @brief Check if the given field exists in the hash table
     @param field Specify the field to query
     @return If the hash table contains the given field, return true, if the hash table does not contain the given field, or key does not exist, return false */
    Boolean exists(Buffer field);

    /*! @brief Delete one or more specified fields in the hash table, non-existent fields will be ignored
     @param fields Specify the field array to delete
     @return The number of deleted fields */
    Integer del(Array fields);

    /*! @brief Delete one or more specified fields in the hash table, non-existent fields will be ignored
     @param fields Specify the field list to delete
     @return The number of deleted fields */
    Integer del(...fields);
};