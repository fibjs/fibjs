/*! @brief dgram is one of the basic modules, mainly used to implement UDP datagram socket encapsulation.

Usage steps:

1. First, introduce the dgram module with the following statement.

```
var dgram = require('dgram');
```

2. Create a UDP datagram socket instance.

```
var sock = dgram.createSocket('udp4');
```

3. Register a data receive event message callback function for the UDP datagram socket.

```
sock.on('message', function (msg, rinfo) {
  // process received message
});
```

4. Send UDP datagram message to the specified destination address.

```
var msg = ...; // message to send
var port = ...; // destination port
var host = ...; // destination host
var bytes = sock.send(msg, 0, msg.length, port, host);
console.log('UDP message sent to ' + host + ':' + port);
```
 */
module dgram
{
    /*! @brief dgram.Socket object is an EventEmitter that encapsulates datagram functions. See DgramSocket
     dgram.Socket instances are created by dgram.createSocket(). Creating a dgram.Socket instance does not require the new keyword.
    */
    static DgramSocket new Socket();

    /*! @brief Create a dgram.Socket object

     opts allowed options are:
     ```JavaScript
     {
         "type": "udp4" | "udp6",   // socket type
         "reuseAddr": true | false, // reuse address, default is false
         "ipv6Only": true | false, // only accept IPv6 packets, default is false
         "recvBufferSize": 1024,     // specify the size of the receive buffer
         "sendBufferSize": 1024      // specify the size of the send buffer
     }
     ```
     @param opts
     @return Return the created Socket object
    */
    static DgramSocket createSocket(Object opts);

    /*! @brief Create a dgram.Socket object

     opts allowed options are:
     ```JavaScript
     {
         "type": "udp4" | "udp6",   // socket type
         "reuseAddr": true | false, // reuse address, default is false
         "ipv6Only": true | false, // only accept IPv6 packets, default is false
         "recvBufferSize": 1024,     // specify the size of the receive buffer
         "sendBufferSize": 1024      // specify the size of the send buffer
     }
     ```
     @param opts
     @param callback Add a listener for the 'message' event.
     @return Return the created Socket object
    */
    static DgramSocket createSocket(Object opts, Function callback);

    /*! @brief Create a dgram.Socket object
     @param type Socket family, 'udp4' or 'udp6'.
     @return Return the created Socket object
    */
    static DgramSocket createSocket(String type);

    /*! @brief Create a dgram.Socket object
     @param type Socket family, 'udp4' or 'udp6'.
     @param callback Add a listener for the 'message' event.
     @return Return the created Socket object
    */
    static DgramSocket createSocket(String type, Function callback);
};