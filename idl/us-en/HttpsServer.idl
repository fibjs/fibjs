/*! @brief HttpsServer is an object used to create https servers, HttpsServer object can use all interface functions and properties of HttpServer. HttpsServer object can provide tls/ssl encrypted protection service to clients by passing in certificate object (X509Cert type) and key object (PKey type) generated by openssl when creating.

Https server object is a combination and encapsulation of TLSServer and HttpHandler, convenient for quickly building servers, logically equivalent to:
```JavaScript
var svr = new tls.Server({
       crt,
       key
   }, addr, port, new http.Handler(function(req){
   ...
}));
```

Below is an example code using HttpsServer:
```JavaScript
const http = require("http");

// create https server
const server = new http.HttpsServer({
       cert,
       key
   }, 8443, function(req) {
   resp.response.write(`Hello, Fibjs!`);
});
server.start();
```

In the above example, we loaded a certificate and private key file named "server.crt" and "server.key", then used HttpsServer object to create a service, and started listening on port 8443, when the client accesses the service through "https://localhost:8443/", it can receive ssl encryption protection.

Note that if external access is needed, make sure the certificate is issued by a reputable authority, otherwise the client cannot verify, reducing performance and security, and may trigger security warnings.
 */
interface HttpsServer : HttpServer
{
    /*! @brief HttpsServer constructor, listen on all local addresses
    @param context SecureContext security context
    @param port specifies the http server listening port
    @param hdlr http built-in message processor, processing function, chain processing array, routing object
    */
    HttpsServer(SecureContext context, Integer port, Handler hdlr);

    /*! @brief HttpsServer constructor
     @param context SecureContext security context
     @param addr specifies the http server listening address, "" means listen on all local addresses
     @param port specifies the http server listening port
     @param hdlr http built-in message processor, processing function, chain processing array, routing object
    */
    HttpsServer(SecureContext context, String addr, Integer port, Handler hdlr);

    /*! @brief HttpsServer constructor, listen on all local addresses

     options in addition to properties used to create SecureContext, also need to provide the following properties:
     - address: specifies the listening address, optional, default listen on all addresses
     - port: specifies the listening port, must provide

     @param options options needed to create security context using tls.createSecureContext
     @param hdlr http built-in message processor, processing function, chain processing array, routing object
    */
    HttpsServer(Object options, Handler hdlr);

    /*! @brief HttpsServer constructor, no port — call listen() to bind and start
     @param context SecureContext security context
     @param hdlr http built-in message processor, processing function, chain processing array, routing object
    */
    HttpsServer(SecureContext context, Handler hdlr);

    /*! @brief Query the SecureContext used by the current HttpsServer */
    readonly SecureContext secureContext;

    /*! @brief Set the SecureContext used by the current HttpsServer
    @param context specifies the new SecureContext
    */
    setSecureContext(SecureContext context);

    /*! @brief Set the SecureContext used by the current HttpsServer
    @param options options needed to create security context using tls.createSecureContext
    */
    setSecureContext(Object options);
};