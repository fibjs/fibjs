/*! @brief Utility for verifying signatures

  The crypto.createVerify() method is used to create Verify instances. Verify objects cannot be created directly using the new keyword.

  Example:
  ```JavaScript
    const {
        generateKeyPairSync,
        createSign,
        createVerify,
    } = require('crypto');

    const { privateKey, publicKey } = generateKeyPairSync('rsa', {
        modulusLength: 2048,
    });

    const sign = createSign('SHA256');
    sign.update('some data to sign');
    const signature = sign.sign(privateKey);

    const verify = createVerify('SHA256');
    verify.update('some data to sign');
    console.log(verify.verify(publicKey, signature));
  ```
 */
interface Verify : object
{
    /*! @brief Update Verify content with given data
     @param data data to update
     @return return Verify object itself
    */
    Verify update(Buffer data);

    /*! @brief Update Verify content with given data
     @param data data to update
     @param codec encoding of data
     @return return Verify object itself
    */
    Verify update(String data, String codec = "utf8");

    /*! @brief Verify the signature of all passed data
     @param privateKey public key used for verification
     @param signature signature to verify
     @return return true if signature is valid, false otherwise
    */
    Boolean verify(Buffer privateKey, Buffer signature);

    /*! @brief Verify the signature of all passed data
     @param privateKey public key used for verification
     @param signature signature to verify
     @return return true if signature is valid, false otherwise
    */
    Boolean verify(KeyObject privateKey, Buffer signature);

    /*! @brief Verify the signature of all passed data

     Parameters in key will be used to call crypto.createPrivateKey to create private key object, additionally supports the following signature parameters:
     - dsaEncoding For DSA and ECDSA, this option specifies the format of the generated signature. It can be one of the following: 
      - 'der' (default): DER-encoded ASN.1 signature structure encoding (r, s) 
      - 'ieee-p1363': Signature format r || s proposed in IEEE-P1363
     - padding RSA optional padding value, one of the following: 
      - RSA_PKCS1_PADDING (default)
      - RSA_PKCS1_PSS_PADDING, RSA_PKCS1_PSS_PADDING will use MGF1 with the same hash function used for signing the message as specified in RFC 4055 Section 3.1
     - saltLength Salt length when padding is RSA_PKCS1_PSS_PADDING. Special value RSA_PSS_SALTLEN_DIGEST sets salt length to digest size, RSA_PSS_SALTLEN_MAX_SIGN (default) sets it to maximum allowed value

     @param key private key used for signing
     @param signature signature to verify
     @return return true if signature is valid, false otherwise
    */
    Boolean verify(Object key, Buffer signature);

    /*! @brief Verify the signature of all passed data
     @param privateKey public key used for verification
     @param signature signature to verify
     @param encoding encoding of signature
     @return return true if signature is valid, false otherwise
    */
    Boolean verify(Buffer privateKey, String signature, String encoding = "buffer");

    /*! @brief Verify the signature of all passed data
     @param privateKey public key used for verification
     @param signature signature to verify
     @param encoding encoding of signature
     @return return true if signature is valid, false otherwise
    */
    Boolean verify(KeyObject privateKey, String signature, String encoding = "buffer");

    /*! @brief Verify the signature of all passed data

     Parameters in key will be used to call crypto.createPrivateKey to create private key object, additionally supports the following signature parameters:
     - dsaEncoding For DSA and ECDSA, this option specifies the format of the generated signature. It can be one of the following: 
      - 'der' (default): DER-encoded ASN.1 signature structure encoding (r, s) 
      - 'ieee-p1363': Signature format r || s proposed in IEEE-P1363
     - padding RSA optional padding value, one of the following: 
      - RSA_PKCS1_PADDING (default)
      - RSA_PKCS1_PSS_PADDING, RSA_PKCS1_PSS_PADDING will use MGF1 with the same hash function used for signing the message as specified in RFC 4055 Section 3.1
     - saltLength Salt length when padding is RSA_PKCS1_PSS_PADDING. Special value RSA_PSS_SALTLEN_DIGEST sets salt length to digest size, RSA_PSS_SALTLEN_MAX_SIGN (default) sets it to maximum allowed value

     @param key private key used for signing
     @param signature signature to verify
     @param encoding encoding of signature
     @return return true if signature is valid, false otherwise
    */
    Boolean verify(Object key, String signature, String encoding = "buffer");
};