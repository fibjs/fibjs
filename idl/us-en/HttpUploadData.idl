/*! @brief Contains a multipart entry data */
interface HttpUploadData : object
{
    /*! @brief Contains the filename of this entry data */
    readonly String fileName;

    /*! @brief Contains the type of this entry data */
    readonly String contentType;

    /*! @brief Contains the transfer encoding type of this entry data */
    readonly String contentTransferEncoding;

    /*! @brief Contains the stream object of this entry data part */
    readonly SeekableStream body;
};