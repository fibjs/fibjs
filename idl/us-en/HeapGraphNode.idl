/*! @brief HeapGraphNode represents a node in the heap view */
interface HeapGraphNode : object
{
    /*! @brief Node type, possible values:
     - profiler.Node_Hidden, hidden node, can be filtered out when displayed to user
     - profiler.Node_Array, array
     - profiler.Node_String, string
     - profiler.Node_Object, JS object (except string and array)
     - profiler.Node_Code, compiled code
     - profiler.Node_Closure, function closure
     - profiler.Node_RegExp, regular expression
     - profiler.Node_HeapNumber, sorted number in heap
     - profiler.Node_Native, Native object (not on v8 heap)
     - profiler.Node_Synthetic, Synthetic object
     - profiler.Node_ConsString, concatenated string
     - profiler.Node_SlicedString, sliced string
     - profiler.Node_Symbol, symbol (ES6)
     - profiler.Node_SimdValue, sorted SIMD value in heap (ES7)
    */
    readonly Integer type;

    /*! @brief node name */
    readonly String name;

    /*! @brief node description */
    readonly String description;

    /*! @brief node ID */
    readonly Integer id;

    /*! @brief node size, in bytes */
    readonly Integer shallowSize;

    /*! @brief child node list, composed of HeapGraphEdge type objects */
    readonly NArray childs;
};