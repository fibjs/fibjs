/*! @brief UUID module for generating and parsing UUIDs
@see https://github.com/uuidjs/uuid
 */
module uuid
{
    /*! @brief DNS namespace */
    const Integer DNS = 0;
    /*! @brief URL namespace */
    const Integer URL = 1;
    /*! @brief OID namespace */
    const Integer OID = 2;
    /*! @brief X509 namespace */
    const Integer X509 = 3;

    /*! @brief Parse UUID string to binary format
     @param uuid UUID string to parse
     @return Returns the parsed binary UUID
     */
    static Buffer parse(String uuid);

    /*! @brief Format binary UUID to string
     @param uuid Binary UUID to format
     @return Returns the formatted UUID string
     */
    static String stringify(Buffer uuid);

    /*! @brief Create UUID v1 (timestamp-based)
     @param options Optional options object, supports the following properties: node (Buffer, node ID), clockseq (Integer, clock sequence), msecs (Integer, millisecond timestamp), nsecs (Integer, nanosecond timestamp)
     @return Returns a generated UUID string
     */
    static String v1(Object options = {});

    /*! @brief Create UUID v3 (MD5 based on namespace and name)
     @param ns Specified namespace, can be uuid.DNS, uuid.URL, uuid.OID, uuid.X509
     @param name Specified name
     @return Returns a generated UUID string
     */
    static String v3(Integer ns, String name);

    /*! @brief Create UUID v4 (random)
     @return Returns a generated UUID string
     */
    static String v4();

    /*! @brief Create UUID v5 (SHA1 based on namespace and name)
     @param ns Specified namespace, can be uuid.DNS, uuid.URL, uuid.OID, uuid.X509
     @param name Specified name
     @return Returns a generated UUID string
     */
    static String v5(Integer ns, String name);

    /*! @brief Get the version number of the UUID
     @param uuid UUID string to query
     @return Returns the UUID version number (0-7), returns undefined if format is invalid
     */
    static Integer version(String uuid);

    /*! @brief Create UUID v6 using reordered timestamp
     @param options Optional options object, supports the following properties: node (Buffer, node ID), clockseq (Integer, clock sequence), msecs (Integer, millisecond timestamp), nsecs (Integer, nanosecond timestamp)
     @return Returns a generated UUID string
     */
    static String v6(Object options = {});

    /*! @brief Create UUID v7 using Unix Epoch timestamp
     @param options Optional options object, supports the following properties: msecs (Integer, millisecond timestamp)
     @return Returns a generated UUID string
     */
    static String v7(Object options = {});

    /*! @brief Convert UUID v1 to v6
     @param uuid UUID string in v1 format
     @return Returns the converted v6 UUID string
     */
    static String v1ToV6(String uuid);

    /*! @brief Convert UUID v6 to v1
     @param uuid UUID string in v6 format
     @return Returns the converted v1 UUID string
     */
    static String v6ToV1(String uuid);

    /*! @brief Validate if UUID string conforms to specification
     @param uuid UUID string to validate
     @return Returns true if conforms, false if not
     */
    static Boolean validate(String uuid);

    /*! @brief Create UUID using time and hostname
     @return Returns a generated binary ID
     */
    static Buffer node();

    /*! @brief Create UUID using named MD5
     @param ns Specified namespace, can be uuid.DNS, uuid.URL, uuid.OID, uuid.X509
     @param name Specified name
     @return Returns a generated binary ID
     */
    static Buffer md5(Integer ns, String name);

    /*! @brief Create UUID using random number
     @return Returns a generated binary ID
     */
    static Buffer random();

    /*! @brief Create UUID using named SHA1
     @param ns Specified namespace, can be uuid.DNS, uuid.URL, uuid.OID, uuid.X509
     @param name Specified name
     @return Returns a generated binary ID
     */
    static Buffer sha1(Integer ns, String name);

    /*! @brief Create UUID using Snowflake algorithm
     @return Returns a generated binary ID
     */
    static Buffer snowflake();

    /*! @brief Query and modify the host ID for Snowflake algorithm */
    static Integer hostID;
};