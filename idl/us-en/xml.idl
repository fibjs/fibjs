/*! @brief XML processing module, can use xml module to parse and process xml and html files

To parse xml file, you can use the following code:
```JavaScript
var xml = require('xml');
var fs = require('fs');

var xmlStr = fs.readFile('test.xml');
var xmlDoc = xml.parse(xmlStr);

console.log(xmlDoc.documentElement.nodeName);  // output root node name
```
In the above code, we used the readFile method of the fs module to read an xml file, then used the parse method of the xml module to parse the xml file and return an XmlDocument object xmlDoc. Then, we can access the root element of the xml document through xmlDoc.documentElement.

To parse html file, you just need to modify the code slightly:
```JavaScript
var xml = require('xml');
var fs = require('fs');

var htmlStr = fs.readFile('test.html');
var xmlDoc = xml.parse(htmlStr, 'text/html');

console.log(xmlDoc.documentElement.nodeName);  // output root node name
```
Here, we also used the readFile method of the fs module to read an html file, but when calling the parse method of the xml module, we specified the second parameter as 'text/html', so the xml module will parse the file according to html syntax rules.

The parsed Xml document objects are all of type XmlDocument, and their properties and methods can be operated according to the xml object model (DOM).
*/
module xml
{
    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlElement object
    */
    const ELEMENT_NODE = 1;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlAttr object
    */
    const ATTRIBUTE_NODE = 2;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlText object
    */
    const TEXT_NODE = 3;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlCDATASection object
    */
    const CDATA_SECTION_NODE = 4;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an EntityReference object (deprecated)
    */
    const ENTITY_REFERENCE_NODE = 5;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an Entity object (deprecated)
    */
    const ENTITY_NODE = 6;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlProcessingInstruction object
    */
    const PROCESSING_INSTRUCTION_NODE = 7;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlComment object
    */
    const COMMENT_NODE = 8;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlDocument object
    */
    const DOCUMENT_NODE = 9;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlDocumentType object
    */
    const DOCUMENT_TYPE_NODE = 10;

    /*! @brief XmlNode's nodeType property constant, indicating the node is an XmlDocumentFragment object
    */
    const DOCUMENT_FRAGMENT_NODE = 11;

    /*! @brief XmlNode's nodeType property constant, indicating the node is a Notation object (deprecated)
    */
    const NOTATION_NODE = 12;

    /*! @brief XML document object, see XmlDocument object*/
    static Document = XmlDocument;

    /*! @brief DOMParser interface for parsing strings into DOM documents, see DOMParser object */
    static DOMParser;

    /*! @brief Parse xml/html text and create XmlDocument object, does not support multiple languages
     @param source Specify the xml/html text to parse
     @param type Specify text type, default is text/xml, can also be text/html
     @return Returns the created XmlDocument object
    */
    static XmlDocument parse(String source, String type = "text/xml");

    /*! @brief Parse xml/html and create XmlDocument object, will convert according to specified language during parsing
     @param source Specify the xml/html binary data to parse
     @param type Specify text type, default is text/xml, can also be text/html
     @return Returns the created XmlDocument object
    */
    static XmlDocument parse(Buffer source, String type = "text/xml");

    /*! @brief Serialize XmlNode to string
     @param node Specify the XmlNode to serialize
     @return Returns the serialized string
    */
    static String serialize(XmlNode node);
};