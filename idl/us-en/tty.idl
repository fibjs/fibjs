/*! @brief tty module

 Usage:
 ```JavaScript
 const tty = require('tty');
 ```
 */
module tty
{
    /*! @brief TTY input stream object, see TTYInputStream */
    static ReadStream = TTYInputStream;

    /*! @brief TTY output stream object, see TTYOutputStream */
    static WriteStream = TTYOutputStream;

    /*! @brief Query if it is a command interactive window
    @param fd file descriptor
     @return Return true if the file descriptor is associated with a terminal window, otherwise return false
    */
    static Boolean isatty(Integer fd);

    /*! @brief Query if it is a command interactive window
    @param fd file handle object
     @return Return true if the file handle is associated with a terminal window, otherwise return false
    */
    static Boolean isatty(FileHandle fd);
};