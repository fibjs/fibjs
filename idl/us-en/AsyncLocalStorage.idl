/*! @brief This object allows you to store and retrieve data in asynchronous operations

 AsyncLocalStorage can be used to pass data in asynchronous call chains, similar to thread-local storage. Each asynchronous operation can access the storage data from when it was created, without confusion with data from other asynchronous operations.

 Here is a simple example:
 ```javascript
 const { AsyncLocalStorage } = require('async_hooks');
 const als = new AsyncLocalStorage();

 als.run({ requestId: 'req-123' }, () => {
     setTimeout(() => {
         const store = als.getStore();
         console.log(store.requestId);  // Output: req-123
     }, 100);
 });
 ```
 */
interface AsyncLocalStorage : object
{
    /*! @brief Create a new AsyncLocalStorage instance

     options supports the following options:
      - defaultValue: Specifies the default value, returned when there is no stored value
      - name: Specifies a name for the AsyncLocalStorage instance, for debugging purposes

     @param options An optional object for configuring the AsyncLocalStorage instance
    */
    AsyncLocalStorage(Object options = {});

    /*! @brief Get the name of the AsyncLocalStorage instance

     The name is set via options.name when creating the instance, for debugging purposes. If not set, returns an empty string.
    */
    readonly String name;

    /*! @brief Create a snapshot function to capture the current asynchronous context

     The returned function can be called at any time, and it will execute the passed callback in the context captured at the time.

     Example:
     ```javascript
     const runInContext = als.run({ id: 1 }, () => AsyncLocalStorage.snapshot());
     // Later in a different context
     als.run({ id: 2 }, () => {
         runInContext(() => {
             console.log(als.getStore().id);  // Output: 1
         });
     });
     ```

     @return Returns a function that accepts a callback and executes it in the captured context
    */
    static Function snapshot();

    /*! @brief Bind a function to the current asynchronous context

     Returns a new function that, when called, executes the original function in the asynchronous context captured at the time.
     This is very useful for ensuring that callback functions execute in the correct context.

     Example:
     ```javascript
     const bound = als.run({ id: 1 }, () => {
         return AsyncLocalStorage.bind(() => als.getStore());
     });
     als.run({ id: 2 }, () => {
         console.log(bound().id);  // Output: 1
     });
     ```

     @param fn The function to bind
     @return Returns the new function bound to the current context
    */
    static Function bind(Function fn);

    /*! @brief Disable the current AsyncLocalStorage instance

     After calling this method, getStore() will return undefined (unless defaultValue is set), and storage data will no longer propagate to subsequent asynchronous operations.
    */
    disable();

    /*! @brief Get the stored data in the current asynchronous context

     If called in a context set by run() or enterWith(), returns the corresponding stored data.
     If not in any context, returns undefined or the defaultValue specified when creating the instance.

     @return Returns the stored data in the current context
    */
    Value getStore();

    /*! @brief Enter a new asynchronous context and set the stored data

     Unlike run(), enterWith() does not require a callback function; it sets the stored data in the current execution context,
     and this data will propagate to all subsequent asynchronous operations until the current asynchronous context ends.

     Example:
     ```javascript
     setImmediate(() => {
         als.enterWith({ id: 1 });
         setTimeout(() => {
             console.log(als.getStore().id);  // Output: 1
         }, 100);
     });
     ```

     @param store The data to store
    */
    enterWith(Value store);

    /*! @brief Run the callback function in a new asynchronous context

     Creates a new asynchronous context, sets the stored data in it, and then executes the callback function.
     Inside the callback and all asynchronous operations triggered by it, the stored data can be obtained via getStore().
     After the callback finishes executing, the context automatically restores to the state before calling run().

     Example:
     ```javascript
     const result = als.run({ userId: 'user-1' }, (a, b) => {
         console.log(als.getStore().userId);  // Output: user-1
         return a + b;
     }, 10, 20);
     console.log(result);  // Output: 30
     ```

     @param store The data to store
     @param callback The callback function to execute
     @param args The arguments to pass to the callback function
     @return Returns the return value of the callback function
    */
    Value run(Value store, Function callback, ...args);

    /*! @brief Temporarily exit the current asynchronous context to execute the callback function

     During the execution of the callback, getStore() will return undefined (or defaultValue).
     After the callback finishes executing, restore to the original context.

     Example:
     ```javascript
     als.run({ id: 1 }, () => {
         console.log(als.getStore().id);  // Output: 1
         als.exit(() => {
             console.log(als.getStore());  // Output: undefined
         });
         console.log(als.getStore().id);  // Output: 1
     });
     ```

     @param callback The callback function to execute
     @param args The arguments to pass to the callback function
     @return Returns the return value of the callback function
    */
    Value exit(Function callback, ...args);
};