/*! @brief XmlNamedNodeMap object represents an unordered list of attributes
*/
interface XmlNamedNodeMap : object
{
    /*! @brief Return the number of attributes in the attribute list
    */
    readonly Integer length;

    /*! @brief Return the attribute at the specified index in the attribute list
     @param index Specify the index to query
     @return The attribute at the specified index
    */
    XmlAttr item(Integer index);

    /*! @brief Can directly access data using subscript
    */
    readonly XmlAttr operator[];

    /*! @brief Query the attribute with the specified name
     @param name Specify the name to query
     @return Return the queried attribute
    */
    XmlAttr getNamedItem(String name);
};