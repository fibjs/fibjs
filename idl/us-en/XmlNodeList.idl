/*! @brief XmlNodeList object represents an ordered list of nodes
*/
interface XmlNodeList : object
{
    /*! @brief Return the number of nodes in the node list
    */
    readonly Integer length;

    /*! @brief Return the node at the specified index in the node list
     @param index Specify the index to query
     @return The node at the specified index
    */
    XmlNode item(Integer index);

    /*! @brief Can directly access data using subscript
    */
    readonly XmlNode operator[];

    /*! @brief Query the iterator of the current object elements
     @return Return the iterator of the current object elements
    */
    Iterator @iterator();
};