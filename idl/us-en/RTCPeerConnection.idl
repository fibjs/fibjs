/*! @brief RTCPeerConnection defines methods and properties for WebRTC connections

RTCPeerConnection is the core object of WebRTC connections, used to create WebRTC connections, manage connection status, send and receive media data, etc.

The creation method of RTCPeerConnection object is as follows:
```JavaScript
const rtc = require('rtc');
var pc = new rtc.RTCPeerConnection();
```
*/
interface RTCPeerConnection : EventEmitter
{
    /*! @brief Construct a new WebRTC connection object and initialize basic parameters

     options parameter is an object containing the following properties:
        - certificateType: certificate type, optional values 'rsa', 'ecdsa', default 'ecdsa'
        - iceTransportPolicy: ICE transport policy, optional values 'all', 'relay', default 'all'
        - iceServers: ICE server list, used for NAT traversal, format [{urls: 'stun:stun.l.google.com:19302'}]
        - maxMessageSize: maximum message size, used to specify the maximum message size of the data channel
        - enableIceUdpMux: whether to enable ICE UDP multiplexing
        - disableFingerprintVerification: whether to disable fingerprint verification
        - bindAddress: bind address, used to specify local IP address
        - port: local port number, used to specify local port
        - iceUfrag: ICE username
        - icePwd: ICE password
        - certPem: certificate in PEM format
        - keyPem: private key in PEM format
        - keyPass: private key password

     @param options Initialization parameters
    */
    RTCPeerConnection(Object options = {});

    /*! @brief Create a new channel connected to the remote peer

     Create a new channel connected to the remote peer, through which any type of data can be transmitted. This is very useful for backchannel content, such as images, file transfers, text chats, game update packets, etc.

     options parameter is an object containing the following properties:
        - ordered: whether to guarantee the order of packets, default true
        - maxPacketLifeTime: maximum lifetime of packets, default 0
        - maxRetransmits: maximum retransmissions of packets, default 0
        - protocol: channel protocol, default ''
        - negotiated: whether it is a negotiated channel, default false
        - id: channel ID, default 0

     @param label Channel name
     @param options Channel parameters
     @return Return the created channel object
    */
    RTCDataChannel createDataChannel(String label, Object options = {});

    /*! @brief Change the local description associated with the connection
    
     This method specifies the properties of the local end of the connection, including media formats. The method takes a single parameter (session description) and returns a Promise that is fulfilled once the description has been asynchronously changed.
    */
    setLocalDescription() promise;

    /*! @brief Change the local description associated with the connection
    
     This method specifies the properties of the local end of the connection, including media formats. The method takes a single parameter (session description) and returns a Promise that is fulfilled once the description has been asynchronously changed.

     @param description Session description
    */
    setLocalDescription(RTCSessionDescription description) promise;

    /*! @brief Change the remote description associated with the connection
    
     This method specifies the properties of the remote end of the connection, including media formats. The method takes a single parameter (session description) and returns a Promise that is fulfilled once the description has been asynchronously changed.

     @param description Session description
    */
    setRemoteDescription(RTCSessionDescription description) promise;

    /*! @brief Add ICE candidate
    
     This method adds an ICE candidate to the remote end of the connection. The method takes a single parameter (ICE candidate) and returns a Promise that is fulfilled once the candidate has been asynchronously changed.

     @param candidate ICE candidate
    */
    addIceCandidate(RTCIceCandidate candidate) promise;

    /*! @brief Create an Offer description
    
     This method creates an Offer description for initiating a connection. The method takes an optional parameter (options object) and returns a Promise that is fulfilled once the description has been asynchronously changed.

     @param options Options object, currently not supported, only for compatibility
     @return Return description object
    */
    Variant createOffer(Object options = {}) promise;

    /*! @brief Create an Answer description
    
     This method creates an Answer description for responding to a connection. The method takes an optional parameter (options object) and returns a Promise that is fulfilled once the description has been asynchronously changed.

     @param options Options object, currently not supported, only for compatibility
     @return Return description object
    */
    Variant createAnswer(Object options = {}) promise;

    /*! @brief Get connection statistics
    
     This method gets the statistics of the connection, returns a Promise that is fulfilled once the statistics are ready.

     @return Return statistics
    */
    NMap getStats() promise;

    /*! @brief Close the connection, this method closes the connection and releases all resources */
    close();

    /*! @brief Get connection state, return connection state string, possible values: 'new', 'connecting', 'connected', 'disconnected', 'failed', 'closed' */
    readonly String connectionState;

    /*! @brief Get ICE connection state, return ICE connection state string, possible values: 'new', 'checking', 'connected', 'completed', 'failed', 'disconnected', 'closed' */
    readonly String iceConnectionState;

    /*! @brief Get ICE gathering state, return ICE gathering state string, possible values: 'new', 'gathering', 'complete' */
    readonly String iceGatheringState;

    /*! @brief Get local description, return local description object */
    readonly Object localDescription;

    /*! @brief Get remote description, return remote description object */
    readonly Object remoteDescription;

    /*! @brief Get remote fingerprint, return remote fingerprint object */
    readonly Object remoteFingerprint;

    /*! @brief Get signaling state, return signaling state string, possible values: 'stable', 'have-local-offer', 'have-remote-offer', 'have-local-pranswer', 'have-remote-pranswer', 'closed' */
    readonly String signalingState;

    /*! @brief Connection state change event */
    event connectionstatechange();

    /*! @brief Data channel event */
    event datachannel();

    /*! @brief ICE candidate event */
    event icecandidate();

    /*! @brief ICE connection state change event */
    event iceconnectionstatechange();

    /*! @brief ICE gathering state change event */
    event icegatheringstatechange();

    /*! @brief Local description change event */
    event localdescription();

    /*! @brief Signaling state change event */
    event signalingstatechange();

    /*! @brief Media track event */
    event track();
};