    static Boolean isKeyObject(Value v);

    /*! @brief Strip TypeScript type annotations from code

     This function removes TypeScript-specific syntax from the provided code string, converting it to plain JavaScript. It handles various TypeScript features including:

     - Type annotations (e.g., `const x: string = "hello";` becomes `const x         = "hello";`)
     - Interface declarations
     - Class property type annotations
     - Generic type parameters
     - Enum declarations
     - Namespace declarations (converted to IIFE)
     - Constructor parameter properties (e.g., `constructor(public x: string)`)
     - `import = require()` syntax
     - `export =` syntax
     - Angle bracket type assertions (e.g., `<T>expr`, use `as` syntax instead)

     Example:
     ```JavaScript
     var util = require('util');
     var ts = 'const x: string = "hello";';
     var js = util.stripTypeScript(ts);
     console.log(js); // 'const x         = "hello";'
     ```

     @param code TypeScript source code
     @return Return the converted JavaScript code
     */
    static String stripTypeScript(String code);

    /*! @brief Get the visual width of a string, considering full-width characters, emoji, and ANSI escape sequences
     Characters with East Asian Width property of Fullwidth (F) or Wide (W) count as 2, most others count as 1.
     Control characters and combining marks count as 0. ANSI escape sequences are skipped.

     @param str The string to measure
     @return Return the visual width of the string
     */
    static Integer getStringWidth(String str);

    /*! @brief Remove ANSI escape sequences (VT control characters) from a string

     @param str The string to strip
     @return Return the string with ANSI escape sequences removed
     */
    static String stripVTControlCharacters(String str);
};