    static Boolean isTypedArray(Value v);

    /*! @brief Detect whether the given variable is Float32Array type

     @param v Given variable to detect
     @return Return True if it is Float32Array type
     */
    static Boolean isFloat32Array(Value v);

    /*! @brief Detect whether the given variable is Float64Array type

     @param v Given variable to detect
     @return Return True if it is Float64Array type
     */
    static Boolean isFloat64Array(Value v);

    /*! @brief Detect whether the given variable is Int8Array type

     @param v Given variable to detect
     @return Return True if it is Int8Array type
     */
    static Boolean isInt8Array(Value v);

    /*! @brief Detect whether the given variable is Int16Array type

     @param v Given variable to detect
     @return Return True if it is Int16Array type
     */
    static Boolean isInt16Array(Value v);

    /*! @brief Detect whether the given variable is Int32Array type

     @param v Given variable to detect
     @return Return True if it is Int32Array type
     */
    static Boolean isInt32Array(Value v);

    /*! @brief Detect whether the given variable is Uint8Array type

     @param v Given variable to detect
     @return Return True if it is Uint8Array type
     */
    static Boolean isUint8Array(Value v);

    /*! @brief Detect whether the given variable is Uint8ClampedArray type

     @param v Given variable to detect
     @return Return True if it is Uint8ClampedArray type
     */
    static Boolean isUint8ClampedArray(Value v);

    /*! @brief Detect whether the given variable is Uint16Array type

     @param v Given variable to detect
     @return Return True if it is Uint16Array type
     */
    static Boolean isUint16Array(Value v);

    /*! @brief Detect whether the given variable is Uint32Array type

     @param v Given variable to detect
     @return Return True if it is Uint32Array type
     */
    static Boolean isUint32Array(Value v);

    /*! @brief Detect whether the given variable is a function object

     @param v Given variable to detect
     @return Return True if it is a function object
     */
    static Boolean isFunction(Value v);

    /*! @brief Detect whether the given variable is a Buffer object

     @param v Given variable to detect
     @return Return True if it is a Buffer object
     */
    static Boolean isBuffer(Value v);

    /*! @brief Detect whether the given variable is a BigInt object, not a primitive type

     @param v Given variable to detect
     @return Return True if it is a BigInt object
     */
    static Boolean isBigIntObject(Value v);

    /*! @brief Detect whether the given variable is a Boolean object, not a primitive type

     @param v Given variable to detect
