    static Boolean isBooleanObject(Value v);

    /*! @brief Detect whether the given variable is a Number object, not a primitive type

     @param v Given variable to detect
     @return Return True if it is a Number object
     */
    static Boolean isNumberObject(Value v);

    /*! @brief Detect whether the given variable is a String object, not a primitive type

     @param v Given variable to detect
     @return Return True if it is a String object
     */
    static Boolean isStringObject(Value v);

    /*! @brief Detect whether the given variable is a Symbol object, not a primitive type

     @param v Given variable to detect
     @return Return True if it is a Symbol object
     */
    static Boolean isSymbolObject(Value v);

    /*! @brief Detect whether the given variable is WeakMap type

