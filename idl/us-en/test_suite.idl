/*! @brief test_suite module is a test suite module, can be called as a function */
module test_suite
{
    /*! @brief Define a test suite, can be nested
     @param name Define project name
     @param block Test content
     */
    static Function(String name, Function block);

    /*! @brief Define a test suite with options, can be nested
     @param name Define project name
     @param options Test options, support: { skip, todo, only }
     @param block Test content
     */
    static Function(String name, Object options, Function block);

    /*! @brief Pause test suite project definition
     @param name Define project name
     @param block Test content
     */
    static skip(String name, Function block);

    /*! @brief Independent test suite project definition
     @param name Define project name
     @param block Test content
     */
    static only(String name, Function block);

    /*! @brief Plan test suite definition
     @param name Define project name
     @param block Test content
     */
    static todo(String name, Function block);

    /*! @brief Plan test suite definition with options
     @param name Define project name
     @param options Test options, support: { skip, todo, only }
     @param block Test content
     */
    static todo(String name, Object options, Function block);
};