/*! @brief TextEncoder encoding object

 Creation method
 ```JavaScript
 var textEncoder = new util.TextEncoder('utf8');
 ```
 */
interface TextEncoder : object
{
    /*! @brief TextEncoder object constructor, construct with parameters
	 @param codec specifies the encoding character set
 	 @param opts specifies encoding options
     */
    TextEncoder(String codec = "utf8", Object opts = {});

    /*! @brief Convert text to binary data
	 @param data text to convert
 	 @param opts specifies encoding options
	 @return returns the encoded binary data
	 */
    Buffer encode(String data = "", Object opts = {});

    /*! @brief Encode text into a destination buffer
	 @param source text to encode
	 @param destination destination buffer to write into
	 @return returns an object with read and written properties
	 */
    Object encodeInto(String source, Buffer destination);

    /*! @brief Query the current encoding character set */
    readonly String encoding;
};