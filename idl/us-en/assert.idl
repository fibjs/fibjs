/*! @brief Assertion test module, if the test value is false, report an error, the error behavior can be set to continue running or throw an error

 Reference method:
 ```JavaScript
 var assert = require('assert');
 ```
 Or reference through the test module:
 ```JavaScript
 var test = require('test');
 var assert = test.assert;
 ```
 Or through test.setup configuration:
 ```JavaScript
 require("test").setup();
 ```
 */
module assert
{
    /*! @brief Assertion error object */
    static readonly Function AssertionError;

    /*! @brief Test that the value is true, fail the assertion if false
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static Function(Value actual = undefined, String msg = "");

    /*! Test that the value is true, fail the assertion if false, alias of assert module */
    static assert new ok();

    /*! Strict test module, see assert_strict module */
    static assert_strict new strict();

    /*! @brief Assertion fails, throw error directly
     @param msg The prompt message when assertion fails
     */
    static fail(String msg = "");

    /*! @brief Test that the value is false, fail the assertion if true
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static notOk(Value actual, String msg = "");

    /*! @brief Test that the value equals the expected value, fail the assertion if not equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static equal(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value does not equal the expected value, fail the assertion if equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static notEqual(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value strictly equals the expected value, fail the assertion if not equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static strictEqual(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value does not strictly equal the expected value, fail the assertion if equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static notStrictEqual(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value deeply equals the expected value, fail the assertion if not equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static deepEqual(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value does not deeply equal the expected value, fail the assertion if equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static notDeepEqual(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value strictly deeply equals the expected value, fail the assertion if not equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static deepStrictEqual(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value does not strictly deeply equal the expected value, fail the assertion if equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static notDeepStrictEqual(Value actual, Value expected, String msg = "");

    /*! @brief Test that the string contains the expected string, fail the assertion otherwise
     @param actual The string to test
     @param expected The expected regular expression
     @param msg The prompt message when assertion fails
     */
    static match(String actual, RegExp expected, String msg = "");

    /*! @brief Test that the string does not contain the expected string, fail the assertion otherwise
     @param actual The string to test
     @param expected The expected regular expression
     @param msg The prompt message when assertion fails
     */
    static doesNotMatch(String actual, RegExp expected, String msg = "");

    /*! @brief Test that the value is approximately equal to the expected value, fail the assertion otherwise
     @param actual The value to test
     @param expected The expected value
     @param delta The approximate decimal precision
     @param msg The prompt message when assertion fails
     */
    static closeTo(Value actual, Value expected, Value delta, String msg = "");

    /*! @brief Test that the value is not approximately equal to the expected value, fail the assertion otherwise
     @param actual The value to test
     @param expected The expected value
     @param delta The approximate decimal precision
     @param msg The prompt message when assertion fails
     */
    static notCloseTo(Value actual, Value expected, Value delta, String msg = "");

    /*! @brief Test that the value is less than the expected value, fail the assertion if greater than or equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static lessThan(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value is not less than the expected value, fail the assertion if less
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static notLessThan(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value is greater than the expected value, fail the assertion if less than or equal
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static greaterThan(Value actual, Value expected, String msg = "");

    /*! @brief Test that the value is not greater than the expected value, fail the assertion if greater
     @param actual The value to test
     @param expected The expected value
     @param msg The prompt message when assertion fails
     */
    static notGreaterThan(Value actual, Value expected, String msg = "");

    /*! @brief Test that the variable exists, fail the assertion if false
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static exist(Value actual, String msg = "");

    /*! @brief Test that the variable does not exist, fail the assertion if true
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static notExist(Value actual, String msg = "");

    /*! @brief Test that the value is boolean true, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isTrue(Value actual, String msg = "");

    /*! @brief Test that the value is not boolean true, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotTrue(Value actual, String msg = "");

    /*! @brief Test that the value is boolean false, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isFalse(Value actual, String msg = "");

    /*! @brief Test that the value is not boolean false, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotFalse(Value actual, String msg = "");

    /*! @brief Test that the value is Null, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNull(Value actual, String msg = "");

    /*! @brief Test that the value is not Null, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotNull(Value actual, String msg = "");

    /*! @brief Test that the value is undefined, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isUndefined(Value actual, String msg = "");

    /*! @brief Test that the value is not undefined, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isDefined(Value actual, String msg = "");

    /*! @brief Test that the value is a function, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isFunction(Value actual, String msg = "");

    /*! @brief Test that the value is not a function, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotFunction(Value actual, String msg = "");

    /*! @brief Test that the value is an object, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isObject(Value actual, String msg = "");

    /*! @brief Test that the value is not an object, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotObject(Value actual, String msg = "");

    /*! @brief Test that the value is an array, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isArray(Value actual, String msg = "");

    /*! @brief Test that the value is not an array, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotArray(Value actual, String msg = "");

    /*! @brief Test that the value is a string, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isString(Value actual, String msg = "");

    /*! @brief Test that the value is not a string, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotString(Value actual, String msg = "");

    /*! @brief Test that the value is a number, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNumber(Value actual, String msg = "");

    /*! @brief Test that the value is not a number, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotNumber(Value actual, String msg = "");

    /*! @brief Test that the value is a boolean, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isBoolean(Value actual, String msg = "");

    /*! @brief Test that the value is not a boolean, fail the assertion otherwise
     @param actual The value to test
     @param msg The prompt message when assertion fails
     */
    static isNotBoolean(Value actual, String msg = "");

    /*! @brief Test that the value is of the given type, fail the assertion otherwise
     @param actual The value to test
     @param type The specified type
     @param msg The prompt message when assertion fails
     */
    static typeOf(Value actual, String type, String msg = "");

    /*! @brief Test that the value is not of the given type, fail the assertion otherwise
     @param actual The value to test
     @param type The specified type
     @param msg The prompt message when assertion fails
     */
    static notTypeOf(Value actual, String type, String msg = "");

    /*! @brief Test that the object contains the specified property, fail the assertion otherwise
     @param object The object to test
     @param prop The property to test
     @param msg The prompt message when assertion fails
     */
    static property(Value object, Value prop, String msg = "");

    /*! @brief Test that the object does not contain the specified property, fail the assertion otherwise
     @param object The object to test
     @param prop The property to test
     @param msg The prompt message when assertion fails
     */
    static notProperty(Value object, Value prop, String msg = "");

    /*! @brief Deep test that the object contains the specified property, fail the assertion otherwise
     @param object The object to test
     @param prop The property to test, separated by "."
     @param msg The prompt message when assertion fails
     */
    static deepProperty(Value object, Value prop, String msg = "");

    /*! @brief Deep test that the object does not contain the specified property, fail the assertion otherwise
     @param object The object to test
     @param prop The property to test, separated by "."
     @param msg The prompt message when assertion fails
     */
    static notDeepProperty(Value object, Value prop, String msg = "");

    /*! @brief Test that the value of the specified property in the object is the given value, fail the assertion otherwise
     @param object The object to test
     @param prop The property to test
     @param value The given value
     @param msg The prompt message when assertion fails
     */
    static propertyVal(Value object, Value prop, Value value, String msg = "");

    /*! @brief Test that the value of the specified property in the object is not the given value, fail the assertion otherwise
     @param object The object to test
     @param prop The property to test
     @param value The given value
     @param msg The prompt message when assertion fails
     */
    static propertyNotVal(Value object, Value prop, Value value, String msg = "");

    /*! @brief Deep test that the value of the specified property in the object is the given value, fail the assertion otherwise
     @param object The object to test
     @param prop The property to test, separated by "."
     @param value The given value
     @param msg The prompt message when assertion fails
     */
    static deepPropertyVal(Value object, Value prop, Value value, String msg = "");

    /*! @brief Deep test that the value of the specified property in the object is not the given value, fail the assertion otherwise
     @param object The object to test
     @param prop The property to test, separated by "."
     @param value The given value
     @param msg The prompt message when assertion fails
     */
    static deepPropertyNotVal(Value object, Value prop, Value value, String msg = "");

    /*! @brief Test that the given code throws an error, fail the assertion if not thrown
     @param block The code to test, given as a function
     @param msg The prompt message when assertion fails
     */
    static throws(Function block, String msg = "");

    /*! @brief Test that the given code throws an error, fail the assertion if not thrown
     @param block The code to test, given as a function
     @param error The specified error, can be RegExp/Function/Object/Error
     @param msg The prompt message when assertion fails
     */
    static throws(Function block, Value error, String msg = "");

    /*! @brief Test that the given code does not throw an error, fail the assertion if thrown
     @param block The code to test, given as a function
     @param msg The prompt message when assertion fails
     */
    static doesNotThrow(Function block, String msg = "");

    /*! @brief Test that the given code throws an error, fail the assertion if not thrown
     @param block The code to test, given as a function
     @param msg The prompt message when assertion fails
     @return Return a Promise
     */
    static Promise rejects(Function block, String msg = "");

    /*! @brief Test that the given code throws an error, fail the assertion if not thrown
     @param block The code to test, given as a function
     @param error The specified error, can be RegExp/Function/Object/Error
     @param msg The prompt message when assertion fails
     @return Return a Promise
     */
    static Promise rejects(Function block, Value error, String msg = "");

    /*! @brief Test that the given code throws an error, fail the assertion if not thrown
     @param result The code to test, given as a Promise
     @param msg The prompt message when assertion fails
     @return Return a Promise
     */
    static Promise rejects(Promise result, String msg = "");

    /*! @brief Test that the given code throws an error, fail the assertion if not thrown
     @param result The code to test, given as a Promise
     @param error The specified error, can be RegExp/Function/Object/Error
     @param msg The prompt message when assertion fails
     @return Return a Promise
     */
    static Promise rejects(Promise result, Value error, String msg = "");

    /*! @brief Throw if the parameter is true
     @param object The parameter
     */
    static ifError(Value object = undefined);
};