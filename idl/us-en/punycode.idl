/*! @brief punycode internationalized domain name conversion module

 Punycode is the character encoding scheme mainly used for internationalized domain names defined by RFC 3492. Because URL hostnames are limited to ASCII characters, hostnames containing non-ASCII characters must be converted to ASCII using the punycode algorithm.

 Usage:
 ```JavaScript
 var punycode = require('punycode');
 ```
 */
module punycode
{
    /*! @brief Convert a Unicode string to an equivalent Punycode string containing only ASCII characters
	 @param domain Given Unicode string
	 @return Return the encoded Punycode string containing only ASCII characters
	 */
    static String encode(String domain);

    /*! @brief Convert a Punycode string to an equivalent Unicode string
	 @param domain Given Unicode string
	 @return Return the decoded Unicode string
	 */
    static String decode(String domain);

    /*! @brief Convert a Unicode string representing a domain name to a string containing only ASCII characters. Only the non-ASCII string parts representing the domain name will be converted. That is, if you call a string that has already been converted to ASCII, it is also fine.
	 @param domain Given Unicode string
	 @return Return the encoded ASCII string
	 */
    static String toASCII(String domain);

    /*! @brief Convert a Punycode string representing a domain name to a Unicode string. Only the Punycode string parts representing the domain name will be converted. That is, if you call a string that has already been converted to Unicode, it is also fine.
	 @param domain Given ASCII string
	 @return Return the decoded Unicode string
	 */
    static String toUnicode(String domain);
};