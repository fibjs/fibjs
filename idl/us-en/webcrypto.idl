/*! @brief WebCrypto API module

The WebCrypto API module provides a set of functions for encryption and decryption. It can be obtained through the webcrypto property of the global object or require("crypto").webcrypto.
*/
module webcrypto
{
    /*! @brief Generate random numbers

    @param data A TypedArray object to store the generated random numbers.
    @return Returns the data object.
    */
    static TypedArray getRandomValues(TypedArray data);

    /*! @brief Generate a UUID

    @return Returns the generated UUID string.
    */
    static String randomUUID();

    /*! @brief CryptoKey class to represent symmetric or asymmetric keys, each key exposes different functions */
    static CryptoKey;

    /*! @brief Provide access to SubtleCrypto API */
    static subtle;
};