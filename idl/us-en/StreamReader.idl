/*! @brief StreamReader object, a lightweight reader compatible with WHATWG ReadableStreamDefaultReader interface

StreamReader wraps a fibjs Stream to provide Web Streams API compatible read() method.
It can be obtained via Stream.getReader().

```JavaScript
const response = await fetch('http://example.com');
const reader = response.body.getReader();
while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    console.log(value);
}
```
*/
interface StreamReader : object
{
    /*! @brief Read the next chunk of data from the stream
     @return Returns an object with `done` (Boolean) and `value` (Buffer data or undefined) properties
     */
    (Boolean done, Buffer value) read() promise;

    /*! @brief Release the lock on the stream */
    releaseLock();

    /*! @brief Cancel the stream and release the lock
     @param reason Optional reason for cancellation
     @return Returns a Promise that resolves when cancellation is complete
     */
    cancel(String reason = "") promise;

    /*! @brief A Promise that resolves when the stream is closed */
    readonly Promise closed;
};
