/*! @brief Basic message object

 Message object is compatible with various mq modules and can be used to build custom message processing systems, creation method:
 ```JavaScript
 var mq = require("mq");
 var m = new mq.Message();
 ```
*/
interface Message : object
{
    /*! @brief Specify message type 1, representing a text type */
    const TEXT = 1;

    /*! @brief Specify message type 2, representing a binary type */
    const BINARY = 2;

    /*! @brief Message object constructor */
    Message();

    /*! @brief Whether the current message has been sent */
    readonly Boolean sent;

    /*! @brief Basic content of the message */
    String value;

    /*! @brief Basic parameters of the message */
    readonly NArray params;

    /*! @brief Message type */
    Integer type;

    /*! @brief Stream object containing the message data part */
    Stream body;

    /*! @brief Read data of specified size from the stream, this method is an alias for the corresponding method of body
     @param bytes Specify the amount of data to read, default is to read a random size data block, the size of the read data depends on the device
     @return Return the data read from the stream, return null if no data can be read or the connection is interrupted
     */
    Buffer read(Integer bytes = -1) async;

    /*! @brief Read all remaining data from the stream, this method is an alias for the corresponding method of body
     @return Return the data read from the stream, return null if no data can be read or the connection is interrupted
     */
    Buffer readAll() async;

    /*! @brief Write the given data, this method is an alias for the corresponding method of body
     @param data Given data to write
     @return Return the actual number of bytes written
     */
    Integer write(Buffer data) async;

    /*! @brief Write the given text data
     @param data Given data to write
     @return This method does not return data
     */
    String text(String data) async;

    /*! @brief Parse the data in the message with text encoding
     @return Return the parsing result
     */
    String text() async;

    /*! @brief Return the data part of the message in binary form
     @return Return the ArrayBuffer object containing the message data part
     */
    ArrayBuffer arrayBuffer() async;

    /*! @brief Return the data part of the message as a Blob object
     @param type MIME type for the Blob, defaults to empty string
     @return Return the Blob object containing the message data part
     */
    Blob blob(String type = "") async;

    /*! @brief Return the data part of the message as a Buffer
     @return Return the Buffer containing the message data part, empty Buffer if no body
     */
    Buffer bytes() async;

    /*! @brief Write the given data with JSON encoding
     @param data Given data to write
     @return This method does not return data
     */
    Variant json(Value data) async;

    /*! @brief Parse the data in the message with JSON encoding
     @return Return the parsing result
     */
    Variant json() async;

    /*! @brief Write the given data with msgpack encoding
     @param data Given data to write
     @return This method does not return data
     */
    Variant pack(Value data) async;

    /*! @brief Parse the data in the message with msgpack encoding
     @return Return the parsing result
     */
    Variant pack() async;

    /*! @brief Length of the message data part */
    readonly Long length;

    /*! @brief Set the current message processing to end, Chain processor no longer continues subsequent transactions
     @return Returns 0 if successful
     */
    Integer end() async;

    /*! @brief Write the given data and set the current message processing to end
     @param data Given data to write
     @return Returns 0 if successful
     */
    Integer end(Buffer data) async;

    /*! @brief Write the given data and set the current message processing to end
     @param data Given data to write
     @param encoding The specified encoding method, since data is Buffer type, this parameter will be ignored
     @return Returns 0 if successful
     */
    Integer end(Buffer data, String encoding) async;

    /*! @brief Write the given string data and set the current message processing to end
     @param data Given string data to write
     @param encoding Specifies the encoding method of the string, default is "utf8"
     @return Returns 0 if successful
     */
    Integer end(String data, String encoding = "utf8") async;

    /*! @brief Query whether the current message is ended
     @return Return true if ended
     */
    Boolean isEnded();

    /*! @brief Clear the content of the message */
    clear();

    /*! @brief Send formatted message to the given stream object
     @param stm Specify the stream object to receive the formatted message
     @param options Specify send options
     */
    sendTo(Stream stm, Object options = {}) async;

    /*! @brief Read formatted message from the given buffered stream object and parse to fill the object
     @param stm Specify the stream object to read the formatted message
     @param options Specify read options
     */
    readFrom(Stream stm, Object options = {}) async;

    /*! @brief Query the stream object when message readFrom */
    readonly Stream stream;

    /*! @brief Query and set the last error of message processing */
    String lastError;

    /*! @brief Copy the current message object
     @return Return the copied message object
    */
    Message clone();
};