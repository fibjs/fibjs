/*! @brief ZlibCodec is the base class for zlib compression/decompression codecs, providing Node.js compatible zlib class constructor interface

 ZlibCodec inherits from EventEmitter and can be used with npm packages like minizlib. Subclasses include Gzip, Gunzip, Deflate, Inflate, DeflateRaw, InflateRaw, Unzip.

 ```JavaScript
 const zlib = require('zlib');
 const gzip = new zlib.Gzip({});
 const result = gzip._processChunk(Buffer.from('hello'), zlib.constants.Z_FINISH);
 ```
 */
interface ZlibCodec : EventEmitter
{
    /*! @brief Synchronously process a chunk of data
     @param chunk The data to process
     @param flushFlag Flush flag, see zlib.constants.Z_NO_FLUSH etc
     @return Returns the processed data
     */
    Buffer _processChunk(Buffer chunk, Integer flushFlag);

    /*! @brief Close the codec, release resources */
    close();

    /*! @brief Reset the codec state */
    reset();

    /*! @brief Internal native handle object for compatibility */
    Value _handle;

    /*! @brief Dynamically update compression parameters
     @param level Compression level
     @param strategy Compression strategy
     */
    params(Integer level, Integer strategy);
};
