/*! @brief Common constant definitions module for zlib module

Reference method:
```JavaScript
var constants = require('zlib').constants
```
 */
module zlib_constants
{
    /*! @brief Do not perform flush operation */
    const Z_NO_FLUSH = 0;

    /*! @brief Perform partial flush operation */
    const Z_PARTIAL_FLUSH = 1;

    /*! @brief Synchronous flush, wait for all pending output to be flushed */
    const Z_SYNC_FLUSH = 2;

    /*! @brief Full flush, wait for all output to be flushed and reset internal state */
    const Z_FULL_FLUSH = 3;

    /*! @brief Complete compression or decompression operation */
    const Z_FINISH = 4;

    /*! @brief Stop compression at the end of current block */
    const Z_BLOCK = 5;

    /*! @brief Operation completed successfully */
    const Z_OK = 0;

    /*! @brief Compression or decompression stream ended */
    const Z_STREAM_END = 1;

    /*! @brief Dictionary needed to continue operation */
    const Z_NEED_DICT = 2;

    /*! @brief System error occurred */
    const Z_ERRNO = -1;

    /*! @brief Stream state inconsistent or invalid parameter */
    const Z_STREAM_ERROR = -2;

    /*! @brief Input data corrupted */
    const Z_DATA_ERROR = -3;

    /*! @brief Memory allocation failed */
    const Z_MEM_ERROR = -4;

    /*! @brief Buffer error */
    const Z_BUF_ERROR = -5;

    /*! @brief Version mismatch */
    const Z_VERSION_ERROR = -6;

    /*! @brief No compression */
    const Z_NO_COMPRESSION = 0;

    /*! @brief Fastest speed compression */
    const Z_BEST_SPEED = 1;

    /*! @brief Highest compression ratio */
    const Z_BEST_COMPRESSION = 9;

    /*! @brief Default compression level */
    const Z_DEFAULT_COMPRESSION = -1;

    /*! @brief Filtered compression strategy */
    const Z_FILTERED = 1;

    /*! @brief Huffman only */
    const Z_HUFFMAN_ONLY = 2;

    /*! @brief Run length encoding */
    const Z_RLE = 3;

    /*! @brief Fixed Huffman encoding */
    const Z_FIXED = 4;

    /*! @brief Default compression strategy */
    const Z_DEFAULT_STRATEGY = 0;

    /*! @brief zlib version number */
    const ZLIB_VERNUM = 4800;

    /*! @brief deflate compression */
    const DEFLATE = 1;

    /*! @brief inflate decompression */
    const INFLATE = 2;

    /*! @brief gzip compression */
    const GZIP = 3;

    /*! @brief gunzip decompression */
    const GUNZIP = 4;

    /*! @brief deflateRaw compression */
    const DEFLATERAW = 5;

    /*! @brief inflateRaw decompression */
    const INFLATERAW = 6;

    /*! @brief unzip decompression */
    const UNZIP = 7;

    /*! @brief Brotli decode */
    const BROTLI_DECODE = 8;

    /*! @brief Brotli encode */
    const BROTLI_ENCODE = 9;

    /*! @brief Minimum window size */
    const Z_MIN_WINDOWBITS = 8;

    /*! @brief Maximum window size */
    const Z_MAX_WINDOWBITS = 15;

    /*! @brief Default window size */
    const Z_DEFAULT_WINDOWBITS = 15;

    /*! @brief Minimum chunk size */
    const Z_MIN_CHUNK = 64;

    /*! @brief Maximum chunk size */
    const Z_MAX_CHUNK = -1;

    /*! @brief Default chunk size */
    const Z_DEFAULT_CHUNK = 16384;

    /*! @brief Minimum memory level */
    const Z_MIN_MEMLEVEL = 1;

    /*! @brief Maximum memory level */
    const Z_MAX_MEMLEVEL = 9;

    /*! @brief Default memory level */
    const Z_DEFAULT_MEMLEVEL = 8;

    /*! @brief Minimum compression level */
    const Z_MIN_LEVEL = -1;

    /*! @brief Maximum compression level */
    const Z_MAX_LEVEL = 9;

    /*! @brief Default compression level */
    const Z_DEFAULT_LEVEL = -1;
};