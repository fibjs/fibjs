/*! @brief HeapGraphEdge represents the association between two HeapGraphNode nodes, from upstream node to downstream node*/
interface HeapGraphEdge : object
{
    /*! @brief The connection method of the downstream node, possible values:
     - profiler.Edge_ContextVariable, variable in function
     - profiler.Edge_Element, element in array
     - profiler.Edge_Property, property of named object
     - profiler.Edge_Internal, link that JS cannot enter
     - profiler.Edge_Hidden, points to node that needs space size calculated in advance
     - profiler.Edge_Shortcut, points to node that cannot calculate space size in advance
     - profiler.Edge_Weak, a weak reference (ignored by GC)
    */
    readonly Integer type;

    /*! @brief link name */
    readonly String name;

    /*! @brief description of the link */
    readonly String description;

    /*! @brief Get the upstream HeapGraphNode node of HeapGraphEdge
     @return Return the source HeapGraphNode node
    */
    HeapGraphNode getFromNode();

    /*! @brief Get the downstream HeapGraphNode node of HeapGraphEdge
     @return Return the destination HeapGraphNode node
    */
    HeapGraphNode getToNode();
};