/*! @brief The XmlNodeList object represents an ordered list of nodes
*/
interface XmlNodeList : object
{
    /*! @brief Returns the number of nodes in the node list
    */
    readonly Integer length;

    /*! @brief Returns the node at the given index in the node list
     @param index the index to query
     @return the node at the given index
    */
    XmlNode item(Integer index);

    /*! @brief Data can be accessed directly with an index
    */
    readonly XmlNode operator[];

    /*! @brief Queries the iterator of the elements of the current object
     @return returns the iterator of the elements of the current object
    */
    Iterator<XmlNode> @iterator();

    /*! @brief Calls the given callback function once for each node in the list
     @param callback the callback function called for each node, receiving three parameters: the current node, the index and the node list itself
    */
    forEach(Function(XmlNode node, Integer index, XmlNodeList list) callback);

    /*! @brief Returns an iterator for traversing the index of each node in the node list
     @return returns the index iterator
    */
    Iterator<Number> keys();

    /*! @brief Returns an iterator for traversing the value of each node in the node list
     @return returns the value iterator
    */
    Iterator<XmlNode> values();

    /*! @brief Returns an iterator for traversing the [index, value] pairs of each node in the node list
     @return returns the key-value pair iterator
    */
    Iterator entries();
};
