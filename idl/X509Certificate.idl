/*! @brief Encapsulates an X509 certificate and provides information reading

```JavaScript
const crypto = require('crypto');
const cert = new crypto.X509Certificate(Buffer.from('...'));
```
*/
interface X509Certificate : object
{
    /*! @brief Creates an X509Certificate object from a certificate

    If cert contains multiple certificates, the returned object will contain the first certificate, and the next() method will return the next certificate

     cert may be the PEM/DER data of the certificate, or the PEM text as a string.
     @param cert the certificate data
    @return returns an X509Certificate object
    */
    X509Certificate(Buffer|String cert);

    /*! @brief Creates an X509Certificate object from a group of certificates

    If certs contains multiple certificates, the returned object will contain the first certificate, and the next() method will return the next certificate; a chain may mix strings and buffers

    @param certs the array of certificates in PEM format
    @return returns an X509Certificate object
    */
    X509Certificate(Buffer|String certs[]);

    /*! @brief The subject of the certificate */
    readonly String subject;

    /*! @brief The serial number of the certificate */
    readonly String serialNumber;

    /*! @brief The certified public key of the certificate */
    readonly KeyObject publicKey;

    /*! @brief The subject alternative names of the certificate */
    readonly String subjectAltName;

    /*! @brief The information access extension of the certificate; returns a newline-separated list of access descriptions. Each line begins with the access method and the type of the access location, followed by a colon and the value associated with the access location */
    readonly String infoAccess;

    /*! @brief The issuer of the certificate */
    readonly String issuer;

    /*! @brief Whether the certificate is a CA certificate */
    readonly Boolean ca;

    /*! @brief The path length constraint of the certificate */
    readonly Integer pathlen;

    /*! @brief The key usage of the certificate */
    readonly String[] keyUsage;

    /*! @brief The Netscape type of the certificate */
    readonly String[] type;

    /*! @brief The start time of the certificate validity period */
    readonly String validFrom;

    /*! @brief The end time of the certificate validity period */
    readonly String validTo;

    /*! @brief The raw binary data of the certificate */
    readonly Buffer raw;

    /*! @brief The PEM encoding of the certificate */
    readonly String pem;

    /*! @brief The SHA-1 fingerprint of the certificate */
    readonly String fingerprint;

    /*! @brief The SHA-256 fingerprint of the certificate */
    readonly String fingerprint256;

    /*! @brief The SHA-512 fingerprint of the certificate */
    readonly String fingerprint512;

    /*! @brief The next certificate in the certificate chain
     @return returns the next certificate
    */
    X509Certificate next();

    /*! @brief Checks whether the certificate matches the given email address

    If the options.subject option is undefined or set to 'default', the certificate subject is considered only when the subject alternative name extension is absent or contains no email addresses.

    If the options.subject option is set to 'always' and the subject alternative name extension is absent or contains no matching email address, the certificate subject is considered.

    If the options.subject option is set to 'never', the certificate subject is never considered, even if the certificate contains no subject alternative names.

    @param email the email address
    @param options the options
    @return returns email if the certificate matches, or undefined if it does not
    */
    String checkEmail(String email, Object options = {});

    /*! @brief Checks whether the certificate matches the given host name

    If the certificate matches the given host name, the matching subject name is returned. The returned name may be an exact match (foo.example.com) or may contain wildcards (*.example.com ). Since host name comparison is case-insensitive, the case of the returned subject name may differ from the given name.

    options supports the following properties:
     - subject: 'default', 'always' or 'never'. Default: 'default'.
     - wildcards: default true.
     - partialWildcards: default true.
     - multiLabelWildcards: default false.
     - singleLabelSubdomains: default false.

    If the options.subject option is undefined or set to 'default', the certificate subject is considered only when the subject alternative name extension is absent or contains no DNS names.

    If the options.subject option is set to 'always' and the subject alternative name extension is absent or contains no matching DNS names, the certificate subject is considered.

    If the options.subject option is set to 'never', the certificate subject is never considered, even if the certificate contains no subject alternative names.

     @param name the host name
     @param options the options
     @return returns the subject name matching name, or undefined if no subject name matches name
    */
    String checkHost(String name, Object options = {});

    /*! @brief Checks whether the certificate matches the given IP address (IPv4 or IPv6)
    @param ip the IP address
    @return returns ip if the certificate matches, or undefined if it does not
    */
    String checkIP(String ip);

    /*! @brief Checks whether this certificate was issued by the given issuer

    issuer may be an X509Certificate object, a PEM string, or a DER/PEM Buffer.
    @param issuer the issuer certificate
    @return returns true if the certificate was issued by issuer, false otherwise
    */
    Boolean checkIssued(X509Certificate|Buffer|String issuer);

    /*! @brief Checks whether the certificate's public key matches the signature of the given private key
    @param privateKey the private key
    @return returns true if they match, false otherwise
    */
    Boolean checkPrivateKey(KeyObject privateKey);

    /*! @brief Verifies that this certificate was signed by the given public key. No other validation checks are performed on the certificate
    @param publicKey the public key
    @return returns true if verification succeeds, false otherwise
    */
    Boolean verify(KeyObject publicKey);
};
