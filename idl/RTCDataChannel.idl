/*! @brief the RTCDataChannel interface defines a bidirectional data channel */
interface RTCDataChannel : EventEmitter
{
    /*! @brief sends binary data; this method is used to send data to the remote end

     @param data the binary data to send
    */
    send(Buffer data);

    /*! @brief sends text data; this method is used to send data to the remote end

     @param data the text data to send
    */
    send(String data);

    /*! @brief closes the channel; this method is used to close the channel */
    close();

    /*! @brief returns the ID number that uniquely identifies the RTCDataChannel */
    readonly Integer id;

    /*! @brief returns a string containing the name describing the data channel */
    readonly String label;

    /*! @brief returns a string containing the name of the sub-protocol in use */
    readonly String protocol;

    /*! @brief returns the number of bytes of data currently queued to be sent over the data channel */
    readonly Number bufferedAmount;

    /*! @brief channel open event, emitted when the channel is opened */
    event open();

    /*! @brief channel message event, emitted when a message is received */
    event message();

    /*! @brief channel close event, emitted when the channel is closed */
    event close();

    /*! @brief channel error event, emitted when an error occurs on the channel */
    event error();

    /*! @brief channel buffered amount low event, emitted when the channel buffered amount is low */
    event bufferedamountlow();
};
