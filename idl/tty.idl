/*! @brief tty module

 Usage:
 ```JavaScript
 const tty = require('tty');
 ```
 */
module tty
{
    /*! @brief TTY input stream object, see TTYInputStream */
    static ReadStream = TTYInputStream;

    /*! @brief TTY output stream object, see TTYOutputStream */
    static WriteStream = TTYOutputStream;

    /*! @brief Queries whether it is a command interactive window
    @param fd the file descriptor; an integer descriptor or a FileHandle object
     @return returns true if it is associated with a terminal window, otherwise returns false
     */
    static Boolean isatty(Integer|FileHandle fd);
};
