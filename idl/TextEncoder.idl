/*! @brief TextEncoder encoding object

 Creation method
 ```JavaScript
 var textEncoder = new util.TextEncoder('utf8');
 ```
 */
interface TextEncoder : object
{
    /*! @brief TextEncoder object constructor, constructed with parameters
	 @param codec the encoding charset
 	 @param opts encoding options
     */
    TextEncoder(String codec = "utf8", Object opts = {});

    /*! @brief Converts text to binary data
	 @param data the text to convert
 	 @param opts encoding options
	 @return returns the encoded binary data
	 */
    Buffer encode(String data = "", Object opts = {});

    /*! @brief Encodes text into the destination buffer
	 @param source the text to encode
	 @param destination the destination buffer to write into
	 @return returns an object containing the read and written properties
	 */
    Object encodeInto(String source, Buffer destination);

    /*! @brief Queries the current encoding charset */
    readonly String encoding;
};
