/*! @brief The zlib_constants module enumerates the constants of the zlib library bundled
 with fibjs: flush codes, status and error codes, compression levels, strategies, window
 and memory bounds, codec type ids, and the library version

 The module is not requireable on its own; load it through the `constants` property of the
 zlib module. The values describe the zlib C library version 1.3.1 linked into this build
 and are accepted by the `flush`, `level`, `windowBits`, `memLevel` and `strategy`
parameters of the compression classes; the codec type ids (`DEFLATE`, `GZIP`, ...) are
also exported.

 Concepts:

 - **Flush modes**: Z_NO_FLUSH lets the compressor buffer and decide when to emit;
   Z_PARTIAL_FLUSH emits the pending output at a partial-block boundary; Z_SYNC_FLUSH emits
   all pending output aligned to a byte boundary and keeps the compression dictionary, so
   the peer can decode the piece immediately; Z_FULL_FLUSH additionally resets the
   dictionary, so decompression can restart from that point; Z_BLOCK stops at the next
   deflate block boundary; Z_FINISH ends the stream and writes the trailer.
 - **Status and error codes**: Z_OK (0) and Z_STREAM_END (1) are success states; Z_NEED_DICT
   asks for a preset dictionary; the negative values (Z_ERRNO, Z_STREAM_ERROR, Z_DATA_ERROR,
   Z_MEM_ERROR, Z_BUF_ERROR, Z_VERSION_ERROR) are zlib return codes. A failed call throws an
   Error whose `code` is the status name, for example 'Z_DATA_ERROR'; the numeric constant
   is the zlib return value, not the error number.
 - **Levels and strategies**: Z_NO_COMPRESSION (0) to Z_BEST_COMPRESSION (9) trade speed for
   size and Z_DEFAULT_COMPRESSION (-1) lets zlib choose (level 6 today). Z_DEFAULT_STRATEGY
   suits ordinary data, Z_FILTERED favors data produced by a filter, Z_HUFFMAN_ONLY and
   Z_RLE restrict LZ matching, and Z_FIXED disables dynamic Huffman codes.
 - **Bounds**: Z_MIN_WINDOWBITS through Z_MAX_WINDOWBITS and Z_MIN_MEMLEVEL through
   Z_MAX_MEMLEVEL bound the codec options; Z_MIN_CHUNK, Z_MAX_CHUNK (-1 means unlimited) and Z_DEFAULT_CHUNK describe chunk sizes.
 - **Where options apply**: the codec classes (`new zlib.Deflate(...)`, `new zlib.Gzip(...)`
   and the rest) read level, windowBits, memLevel and strategy; the one-shot functions only
   read level, so pass the other options to a codec instance.

 Import:
 ```JavaScript
 const constants = require('zlib').constants;
 ```

 Example 1 — flush control on a streaming codec:
 ```JavaScript
 const zlib = require('zlib');
 const C = zlib.constants;

 // _processChunk(data, flushFlag) drives one codec step at a time.
 const deflate = new zlib.Deflate();
 const head = deflate._processChunk('hello ', C.Z_NO_FLUSH);    // header only
 const middle = deflate._processChunk('world', C.Z_SYNC_FLUSH); // decodable piece
 const tail = deflate._processChunk('', C.Z_FINISH);            // trailer

 console.log(head.length, middle.length, tail.length); // 2 17 6
 const packed = Buffer.concat([head, middle, tail]);
 console.log(zlib.inflate(packed).toString()); // hello world
 ```

 Example 2 — compression levels:
 ```JavaScript
 const zlib = require('zlib');
 const C = zlib.constants;
 const text = 'abc'.repeat(1000);

 // Z_NO_COMPRESSION stores, Z_BEST_COMPRESSION spends CPU to shrink.
 const stored = zlib.deflate(text, { level: C.Z_NO_COMPRESSION });
 const packed = zlib.deflate(text, { level: C.Z_BEST_COMPRESSION });
 console.log(stored.length > packed.length); // true

 // Without a level the one-shot uses Z_DEFAULT_COMPRESSION (-1).
 console.log(C.Z_DEFAULT_COMPRESSION, C.Z_MIN_LEVEL, C.Z_MAX_LEVEL); // -1 -1 9
 console.log(zlib.deflate(text).length ===
     zlib.deflate(text, { level: C.Z_DEFAULT_COMPRESSION }).length); // true
 ```

 Example 3 — strategies and error codes:
 ```JavaScript
 const zlib = require('zlib');
 const C = zlib.constants;
 const text = 'The quick brown fox jumps over the lazy dog. '.repeat(50);

 // Strategies are codec-constructor options: HUFFMAN_ONLY gives up LZ matching.
 const plain = new zlib.Deflate({ strategy: C.Z_DEFAULT_STRATEGY });
 const huff = new zlib.Deflate({ strategy: C.Z_HUFFMAN_ONLY });
 const a = plain._processChunk(text, C.Z_FINISH);
 const b = huff._processChunk(text, C.Z_FINISH);
 console.log(a.length < b.length); // true

 // A failed inflate reports the zlib status name in err.code.
 try {
     zlib.inflate(Buffer.from('not a zlib stream'));
 } catch (e) {
     console.log(e.code); // Z_DATA_ERROR
 }
 console.log(C.Z_OK, C.Z_STREAM_END, C.Z_DATA_ERROR, C.Z_VERSION_ERROR); // 0 1 -3 -6
 ```
 */
module zlib_constants
{
    /*! @brief Performs no flush operation */
    const Z_NO_FLUSH = 0;

    /*! @brief Performs a partial flush operation */
    const Z_PARTIAL_FLUSH = 1;

    /*! @brief Synchronous flush, waits for all pending output to be flushed */
    const Z_SYNC_FLUSH = 2;

    /*! @brief Full flush, waits for all output to be flushed and resets the internal state */
    const Z_FULL_FLUSH = 3;

    /*! @brief Finishes the compression or decompression operation */
    const Z_FINISH = 4;

    /*! @brief Stops compression at the end of the current block */
    const Z_BLOCK = 5;

    /*! @brief The operation completed successfully */
    const Z_OK = 0;

    /*! @brief End of the compression or decompression stream */
    const Z_STREAM_END = 1;

    /*! @brief A dictionary is required to continue the operation */
    const Z_NEED_DICT = 2;

    /*! @brief A system error occurred */
    const Z_ERRNO = -1;

    /*! @brief Inconsistent stream state or invalid parameter */
    const Z_STREAM_ERROR = -2;

    /*! @brief The input data is corrupted */
    const Z_DATA_ERROR = -3;

    /*! @brief Memory allocation failed */
    const Z_MEM_ERROR = -4;

    /*! @brief Buffer error */
    const Z_BUF_ERROR = -5;

    /*! @brief Version mismatch */
    const Z_VERSION_ERROR = -6;

    /*! @brief No compression */
    const Z_NO_COMPRESSION = 0;

    /*! @brief Fastest compression speed */
    const Z_BEST_SPEED = 1;

    /*! @brief Best compression ratio */
    const Z_BEST_COMPRESSION = 9;

    /*! @brief Default compression level */
    const Z_DEFAULT_COMPRESSION = -1;

    /*! @brief Filtered compression strategy */
    const Z_FILTERED = 1;

    /*! @brief Huffman coding only */
    const Z_HUFFMAN_ONLY = 2;

    /*! @brief Run-length encoding */
    const Z_RLE = 3;

    /*! @brief Fixed Huffman coding */
    const Z_FIXED = 4;

    /*! @brief Default compression strategy */
    const Z_DEFAULT_STRATEGY = 0;

    /*! @brief zlib version number (4880 is zlib 1.3.1) */
    const ZLIB_VERNUM = 4880;

    /*! @brief deflate compression */
    const DEFLATE = 1;

    /*! @brief inflate decompression */
    const INFLATE = 2;

    /*! @brief gzip compression */
    const GZIP = 3;

    /*! @brief gunzip decompression */
    const GUNZIP = 4;

    /*! @brief deflateRaw compression */
    const DEFLATERAW = 5;

    /*! @brief inflateRaw decompression */
    const INFLATERAW = 6;

    /*! @brief unzip decompression */
    const UNZIP = 7;

    /*! @brief Brotli decoding */
    const BROTLI_DECODE = 8;

    /*! @brief Brotli encoding */
    const BROTLI_ENCODE = 9;

    /*! @brief Minimum window size */
    const Z_MIN_WINDOWBITS = 8;

    /*! @brief Maximum window size */
    const Z_MAX_WINDOWBITS = 15;

    /*! @brief Default window size */
    const Z_DEFAULT_WINDOWBITS = 15;

    /*! @brief Minimum chunk size */
    const Z_MIN_CHUNK = 64;

    /*! @brief Maximum chunk size; -1 means unlimited */
    const Z_MAX_CHUNK = -1;

    /*! @brief Default chunk size */
    const Z_DEFAULT_CHUNK = 16384;

    /*! @brief Minimum memory level */
    const Z_MIN_MEMLEVEL = 1;

    /*! @brief Maximum memory level */
    const Z_MAX_MEMLEVEL = 9;

    /*! @brief Default memory level */
    const Z_DEFAULT_MEMLEVEL = 8;

    /*! @brief Minimum compression level */
    const Z_MIN_LEVEL = -1;

    /*! @brief Maximum compression level */
    const Z_MAX_LEVEL = 9;

    /*! @brief Default compression level */
    const Z_DEFAULT_LEVEL = -1;

    /*! @brief zstd compression codec type id */
    const ZSTD_COMPRESS = 10;

    /*! @brief zstd decompression codec type id */
    const ZSTD_DECOMPRESS = 11;

    /*! @brief zstd end directive: keep buffering input */
    const ZSTD_e_continue = 0;

    /*! @brief zstd end directive: emit everything produced so far */
    const ZSTD_e_flush = 1;

    /*! @brief zstd end directive: finish the frame and write its trailer */
    const ZSTD_e_end = 2;

    /*! @brief zstd compression strategy: fastest, no matching */
    const ZSTD_fast = 1;

    /*! @brief zstd compression strategy: double fast */
    const ZSTD_dfast = 2;

    /*! @brief zstd compression strategy: greedy */
    const ZSTD_greedy = 3;

    /*! @brief zstd compression strategy: lazy */
    const ZSTD_lazy = 4;

    /*! @brief zstd compression strategy: lazy2 */
    const ZSTD_lazy2 = 5;

    /*! @brief zstd compression strategy: binary tree with lazy2 */
    const ZSTD_btlazy2 = 6;

    /*! @brief zstd compression strategy: binary tree with optimal parsing */
    const ZSTD_btopt = 7;

    /*! @brief zstd compression strategy: binary tree, ultra */
    const ZSTD_btultra = 8;

    /*! @brief zstd compression strategy: binary tree, ultra 2 */
    const ZSTD_btultra2 = 9;

    /*! @brief zstd parameter: compression level */
    const ZSTD_c_compressionLevel = 100;

    /*! @brief zstd parameter: maximum back-reference distance, as a power of 2 */
    const ZSTD_c_windowLog = 101;

    /*! @brief zstd parameter: size of the initial probe table, as a power of 2 */
    const ZSTD_c_hashLog = 102;

    /*! @brief zstd parameter: size of the multi-probe search table, as a power of 2 */
    const ZSTD_c_chainLog = 103;

    /*! @brief zstd parameter: number of search attempts, as a power of 2 */
    const ZSTD_c_searchLog = 104;

    /*! @brief zstd parameter: minimum size of searched matches */
    const ZSTD_c_minMatch = 105;

    /*! @brief zstd parameter: impact of this field depends on the strategy */
    const ZSTD_c_targetLength = 106;

    /*! @brief zstd parameter: compression strategy, see the ZSTD_* strategy constants */
    const ZSTD_c_strategy = 107;

    /*! @brief zstd parameter: enable long distance matching */
    const ZSTD_c_enableLongDistanceMatching = 160;

    /*! @brief zstd parameter: long distance matcher table size, as a power of 2 */
    const ZSTD_c_ldmHashLog = 161;

    /*! @brief zstd parameter: minimum match size of the long distance matcher */
    const ZSTD_c_ldmMinMatch = 162;

    /*! @brief zstd parameter: log size of each long distance matcher bucket */
    const ZSTD_c_ldmBucketSizeLog = 163;

    /*! @brief zstd parameter: long distance matcher hash rate, as a power of 2 */
    const ZSTD_c_ldmHashRateLog = 164;

    /*! @brief zstd parameter: write the content size into the frame header when known */
    const ZSTD_c_contentSizeFlag = 200;

    /*! @brief zstd parameter: write a 32-bit content checksum at the end of the frame */
    const ZSTD_c_checksumFlag = 201;

    /*! @brief zstd parameter: write the dictionary id into the frame header */
    const ZSTD_c_dictIDFlag = 202;

    /*! @brief zstd parameter: number of worker threads for multi-threaded compression */
    const ZSTD_c_nbWorkers = 400;

    /*! @brief zstd parameter: size of one compression job, enforced when nbWorkers is set */
    const ZSTD_c_jobSize = 401;

    /*! @brief zstd parameter: overlap size between jobs, as a fraction of the window */
    const ZSTD_c_overlapLog = 402;

    /*! @brief zstd parameter: largest window the decompressor reserves memory for */
    const ZSTD_d_windowLogMax = 100;

    /*! @brief zstd default compression level */
    const ZSTD_CLEVEL_DEFAULT = 3;

    /*! @brief zstd error: no error */
    const ZSTD_error_no_error = 0;

    /*! @brief zstd error: an unspecified error occurred */
    const ZSTD_error_GENERIC = 1;

    /*! @brief zstd error: the frame header is not recognized */
    const ZSTD_error_prefix_unknown = 10;

    /*! @brief zstd error: the frame requires an unsupported library version */
    const ZSTD_error_version_unsupported = 12;

    /*! @brief zstd error: a frame header parameter is not supported */
    const ZSTD_error_frameParameter_unsupported = 14;

    /*! @brief zstd error: the frame window is larger than the decoder allows */
    const ZSTD_error_frameParameter_windowTooLarge = 16;

    /*! @brief zstd error: the input is corrupted */
    const ZSTD_error_corruption_detected = 20;

    /*! @brief zstd error: the content checksum does not match */
    const ZSTD_error_checksum_wrong = 22;

    /*! @brief zstd error: the literals section header is malformed */
    const ZSTD_error_literals_headerWrong = 24;

    /*! @brief zstd error: the dictionary is corrupted */
    const ZSTD_error_dictionary_corrupted = 30;

    /*! @brief zstd error: the dictionary does not match the frame */
    const ZSTD_error_dictionary_wrong = 32;

    /*! @brief zstd error: the dictionary could not be created */
    const ZSTD_error_dictionaryCreation_failed = 34;

    /*! @brief zstd error: a parameter is not supported */
    const ZSTD_error_parameter_unsupported = 40;

    /*! @brief zstd error: this combination of parameters is not supported */
    const ZSTD_error_parameter_combination_unsupported = 41;

    /*! @brief zstd error: a parameter value is out of range */
    const ZSTD_error_parameter_outOfBound = 42;

    /*! @brief zstd error: a table log is too large */
    const ZSTD_error_tableLog_tooLarge = 44;

    /*! @brief zstd error: a maximum symbol value is too large */
    const ZSTD_error_maxSymbolValue_tooLarge = 46;

    /*! @brief zstd error: a maximum symbol value is too small */
    const ZSTD_error_maxSymbolValue_tooSmall = 48;

    /*! @brief zstd error: a stability condition is not respected */
    const ZSTD_error_stabilityCondition_notRespected = 50;

    /*! @brief zstd error: the call is made at the wrong stage */
    const ZSTD_error_stage_wrong = 60;

    /*! @brief zstd error: the context is not initialized */
    const ZSTD_error_init_missing = 62;

    /*! @brief zstd error: memory allocation failed */
    const ZSTD_error_memory_allocation = 64;

    /*! @brief zstd error: the workspace is too small */
    const ZSTD_error_workSpace_tooSmall = 66;

    /*! @brief zstd error: the destination buffer is too small */
    const ZSTD_error_dstSize_tooSmall = 70;

    /*! @brief zstd error: the source size does not match the pledged size */
    const ZSTD_error_srcSize_wrong = 72;

    /*! @brief zstd error: the destination buffer is null */
    const ZSTD_error_dstBuffer_null = 74;

    /*! @brief zstd error: the destination filled up and no progress was made */
    const ZSTD_error_noForwardProgress_destFull = 80;

    /*! @brief zstd error: the input is empty and no progress was made */
    const ZSTD_error_noForwardProgress_inputEmpty = 82;
};
