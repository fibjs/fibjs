/*! @brief 消息处理器接口 */
interface Handler : object
{
    /*! @brief 构造一个消息处理器链处理对象
     @param hdlrs 处理器数组
     */
    Handler(Handler hdlrs[]);

    /*! @brief 创建一个消息处理器路由对象
     @param map 初始化路由参数
     */
    Handler(Object map);

    /*! @brief 创建一个 JavaSvript 消息处理器
     @param hdlr JavaScript 处理器函数
     */
    Handler(Function hdlr);

    /*! @brief 构造一个 fileHandler 或者 HttpRepeater
     @param hdlr 处理器的地址参数
     */
    Handler(String hdlr);

    /*! @brief 查询当前处理器是否支持路由
     @return 返回当前处理器是否支持路由
     */
    Boolean isRouting();

    /*! @brief 处理一个消息或对象
     @param v 指定处理的消息或对象
     @return 返回下一步的处理器
     */
    Handler invoke(object v) async;
};
