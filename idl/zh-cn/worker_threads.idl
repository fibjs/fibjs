/*! @brief worker 基础模块

 引用方法：
 ```JavaScript
 var worker_threads = require('worker_threads');
 ```
 */
module worker_threads
{
    /*! @brief 独立线程工作对象，参见 Worker */
    static Worker;

    /*! @brief 消息通道的一端，参见 MessagePort */
    static MessagePort;

    /*! @brief 一对相连的 MessagePort 对象，参见 MessageChannel */
    static MessageChannel;

    /*! @brief 查询当前 Worker 是不是主线程 */
    static readonly Boolean isMainThread;

    /*! @brief 查询当前执行上下文的逻辑 worker 标识 */
    static readonly Integer threadId;

    /*! @brief 查询当前 Worker 的父线程 */
    static readonly MessagePort parentPort;

    /*! @brief 查询父线程通过 Worker 构造函数传给该线程的的数据的克隆 */
    static readonly Value workerData;

    /*! @brief 同步接收 MessagePort 上排队的下一条消息 */
    static Value receiveMessageOnPort(MessagePort port);
};
