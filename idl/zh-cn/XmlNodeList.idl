/*! @brief XmlNodeList 对象代表一个有顺序的节点列表
*/
interface XmlNodeList : object
{
    /*! @brief 返回节点列表中的节点数目
    */
    readonly Integer length;

    /*! @brief 返回节点列表中处于指定的索引号的节点
     @param index 指定要查询的索引
     @return 指定索引号的节点
    */
    XmlNode item(Integer index);

    /*! @brief 可使用下标直接访问数据
    */
    readonly XmlNode operator[];

    /*! @brief 查询当前对象元素的迭代器
     @return 返回当前对象元素的迭代器
    */
    Iterator @iterator();

    /*! @brief 对列表中的每个节点执行一次指定的回调函数
     @param callback 对每个节点执行的回调函数，接收三个参数：当前节点、索引、节点列表本身
    */
    forEach(Function callback);
};
