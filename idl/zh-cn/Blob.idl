/**/
interface Blob : object
{
    /*! @brief Blob 对象构造函数
     @param blobParts 初始化数据数组，可以包含字符串、ArrayBuffer、TypedArray、Blob 等
     @param options 选项对象，包含 type 和 endings 属性
     */
    Blob(Array blobParts = [], Object options = {});

    /*! @brief Blob 对象类型 */
    readonly String type;

    /*! @brief Blob 对象的大小 */
    readonly Integer size;

    /*! @brief 返回指定范围的 Blob 切片
     @param start 起始位置（可选）
     @param end 结束位置（可选）
     @param contentType 内容类型（可选）
     @return 返回新的 Blob 对象
     */
    Blob slice(Integer start = 0, Integer end = -1, String contentType = "");

    /*! @brief 以文本形式读取 Blob 内容
     @return 返回包含文本内容的 Promise
     */
    String text() promise;

    /*! @brief 以 ArrayBuffer 形式读取 Blob 内容
     @return 返回包含二进制数据的 Promise
     */
    ArrayBuffer arrayBuffer() promise;
};
