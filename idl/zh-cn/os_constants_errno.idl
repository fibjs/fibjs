/*! @brief os_constants errno 子模块，包含 POSIX 错误码常量

 引用方法：
 ```JavaScript
 var errno = require('os').constants.errno
 ```
 */
module os_constants_errno
{
    /*! @brief 参数列表过长 */
    const E2BIG = 7;

    /*! @brief 权限不足 */
    const EACCES = 13;

    /*! @brief 地址已被占用 */
    const EADDRINUSE = 98;

    /*! @brief 地址不可用 */
    const EADDRNOTAVAIL = 99;

    /*! @brief 地址族不受支持 */
    const EAFNOSUPPORT = 97;

    /*! @brief 资源暂时不可用，可重试 */
    const EAGAIN = 11;

    /*! @brief 操作已在执行中 */
    const EALREADY = 114;

    /*! @brief 无效的文件描述符 */
    const EBADF = 9;

    /*! @brief 无效的消息 */
    const EBADMSG = 74;

    /*! @brief 设备或资源忙 */
    const EBUSY = 16;

    /*! @brief 操作已取消 */
    const ECANCELED = 125;

    /*! @brief 没有子进程 */
    const ECHILD = 10;

    /*! @brief 连接被中止 */
    const ECONNABORTED = 103;

    /*! @brief 连接被拒绝 */
    const ECONNREFUSED = 111;

    /*! @brief 连接被重置 */
    const ECONNRESET = 104;

    /*! @brief 资源死锁 */
    const EDEADLK = 35;

    /*! @brief 需要目标地址 */
    const EDESTADDRREQ = 89;

    /*! @brief 数学参数超出函数定义域 */
    const EDOM = 33;

    /*! @brief 磁盘配额超限 */
    const EDQUOT = 122;

    /*! @brief 文件已存在 */
    const EEXIST = 17;

    /*! @brief 无效的内存地址 */
    const EFAULT = 14;

    /*! @brief 文件过大 */
    const EFBIG = 27;

    /*! @brief 主机不可达 */
    const EHOSTUNREACH = 113;

    /*! @brief 标识符已删除 */
    const EIDRM = 43;

    /*! @brief 非法字节序列 */
    const EILSEQ = 84;

    /*! @brief 操作正在进行中 */
    const EINPROGRESS = 115;

    /*! @brief 被信号中断 */
    const EINTR = 4;

    /*! @brief 无效的参数 */
    const EINVAL = 22;

    /*! @brief I/O 错误 */
    const EIO = 5;

    /*! @brief 套接字已连接 */
    const EISCONN = 106;

    /*! @brief 路径是目录 */
    const EISDIR = 21;

    /*! @brief 符号链接层数过多 */
    const ELOOP = 40;

    /*! @brief 打开的文件过多 */
    const EMFILE = 24;

    /*! @brief 链接数过多 */
    const EMLINK = 31;

    /*! @brief 消息过长 */
    const EMSGSIZE = 90;

    /*! @brief 多跳尝试 */
    const EMULTIHOP = 72;

    /*! @brief 文件名过长 */
    const ENAMETOOLONG = 36;

    /*! @brief 网络已关闭 */
    const ENETDOWN = 100;

    /*! @brief 连接被网络重置 */
    const ENETRESET = 102;

    /*! @brief 网络不可达 */
    const ENETUNREACH = 101;

    /*! @brief 系统文件表溢出 */
    const ENFILE = 23;

    /*! @brief 无可用缓冲区 */
    const ENOBUFS = 105;

    /*! @brief 无可用数据 */
    const ENODATA = 61;

    /*! @brief 无此设备 */
    const ENODEV = 19;

    /*! @brief 文件或目录不存在 */
    const ENOENT = 2;

    /*! @brief 可执行文件格式错误 */
    const ENOEXEC = 8;

    /*! @brief 无可用锁 */
    const ENOLCK = 37;

    /*! @brief 链接已断开 */
    const ENOLINK = 67;

    /*! @brief 内存不足 */
    const ENOMEM = 12;

    /*! @brief 没有指定类型的消息 */
    const ENOMSG = 42;

    /*! @brief 协议不可用 */
    const ENOPROTOOPT = 92;

    /*! @brief 设备上没有剩余空间 */
    const ENOSPC = 28;

    /*! @brief 没有可用的流资源 */
    const ENOSR = 63;

    /*! @brief 不是流设备 */
    const ENOSTR = 60;

    /*! @brief 功能未实现 */
    const ENOSYS = 38;

    /*! @brief 套接字未连接 */
    const ENOTCONN = 107;

    /*! @brief 路径不是目录 */
    const ENOTDIR = 20;

    /*! @brief 目录非空 */
    const ENOTEMPTY = 39;

    /*! @brief 不是套接字 */
    const ENOTSOCK = 88;

    /*! @brief 不支持的操作 */
    const ENOTSUP = 95;

    /*! @brief 不适当的 ioctl 操作 */
    const ENOTTY = 25;

    /*! @brief 无此设备或地址 */
    const ENXIO = 6;

    /*! @brief 套接字不支持的操作 */
    const EOPNOTSUPP = 95;

    /*! @brief 数值过大 */
    const EOVERFLOW = 75;

    /*! @brief 操作不允许 */
    const EPERM = 1;

    /*! @brief 管道破裂 */
    const EPIPE = 32;

    /*! @brief 协议错误 */
    const EPROTO = 71;

    /*! @brief 协议不受支持 */
    const EPROTONOSUPPORT = 93;

    /*! @brief 套接字协议类型错误 */
    const EPROTOTYPE = 91;

    /*! @brief 结果超出范围 */
    const ERANGE = 34;

    /*! @brief 只读文件系统 */
    const EROFS = 30;

    /*! @brief 无效的 seek 操作 */
    const ESPIPE = 29;

    /*! @brief 没有此进程 */
    const ESRCH = 3;

    /*! @brief 过期的文件句柄 */
    const ESTALE = 116;

    /*! @brief 定时器过期 */
    const ETIME = 62;

    /*! @brief 操作超时 */
    const ETIMEDOUT = 110;

    /*! @brief 文本文件忙 */
    const ETXTBSY = 26;

    /*! @brief 操作会阻塞 */
    const EWOULDBLOCK = 11;

    /*! @brief 跨设备链接 */
    const EXDEV = 18;
};
