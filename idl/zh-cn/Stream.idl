/*! @brief 流操作对象，用于二进制数据流读写

Stream 为基础对象，用于为流处理定义标准借口，不能独立创建 */
interface Stream : EventEmitter
{
    /*! @brief 查询 Stream 对应的文件描述符值, 由子类实现 */
    readonly Integer fd;

    /*! @brief 查询流是否可写 */
    readonly Boolean writable;

    /*! @brief 查询流是否可读 */
    readonly Boolean readable;

    /*! @brief 查询流的可读状态对象 */
    readonly Object _readableState;

    /*! @brief 查询流的可写状态对象 */
    readonly Object _writableState;

    /*! @brief 从流内读取指定大小的数据
     @param bytes 指定要读取的数据量，缺省为读取随机大小的数据块，读出的数据尺寸取决于设备
     @return 返回从流内读取的数据。若设置了编码则返回字符串，否则返回 Buffer。若无数据可读，或者连接中断，则返回 null
     */
    Variant read(Integer bytes = -1) async;

    /*! @brief 从流内读取指定大小的数据，以 Buffer 形式返回
     @param bytes 指定要读取的数据量，缺省为读取随机大小的数据块，读出的数据尺寸取决于设备
     @return 返回从流内读取的 Buffer 数据，若无数据可读，或者连接中断，则返回 null
     */
    Buffer readBuffer(Integer bytes = -1) async;

    /*! @brief 设置流的编码方式。设置后 read() 将返回字符串而非 Buffer 对象
     @param encoding 要使用的编码，如 'utf8'、'ascii'、'hex' 等。传入 null 恢复为 Buffer 模式
     @return 返回当前流对象
     */
    Stream setEncoding(String encoding);

    /*! @brief 将给定的二进制数据写入流
     @param data 给定要写入的 Buffer 数据
     */
    writeBuffer(Buffer data) async;

    /*! @brief 将给定的数据写入流
     @param data 给定要写入的数据
     @return 如果流希望调用代码在继续写入其他数据之前等待 'drain' 事件，则返回 true；否则返回 false
     */
    Boolean write(Buffer data) async;

    /*! @brief 将给定的数据写入流
     @param data 给定要写入的数据
     @param encoding 指定的编码方式，因为 data 为 Buffer 类型，此参数将被忽略
     @return 如果流希望调用代码在继续写入其他数据之前等待 'drain' 事件，则返回 true；否则返回 false
     */
    Boolean write(Buffer data, String encoding) async;

    /*! @brief 将给定的字符串写入流
     @param data 给定要写入的字符串数据
     @param encoding 指定字符串的编码方式，缺省为 "utf8"
     @return 如果流希望调用代码在继续写入其他数据之前等待 'drain' 事件，则返回 true；否则返回 false
     */
    Boolean write(String data, String encoding = "utf8") async;

    /*! @brief 将流切换到流动读取模式。在 fibjs 下，切换到流动读取模式是不可逆的，不能再切换回非流动读取模式。
     @return 返回当前流对象
     */
    Stream resume();

    /*! @brief 暂停流的自动读取模式。此方法仅为兼容，目前调用此方法不会有任何效果
     @return 返回当前流对象
     */
    Stream pause();

    /*! @brief 将流数据管道传输到目标流。数据通过事件驱动方式从源流传输到目标流，支持背压控制
     @param destination 目标流对象
     @param options 管道选项，可选
     @return 返回目标流对象，支持链式调用
     */
    Value pipe(Value destination, Object options = {});

    /*! @brief 移除所有管道目标，或仅移除指定的目标。此方法仅为兼容，目前调用此方法不会有任何效果
     @param destination 要取消管道的特定可写目标
     */
    unpipe(Stream destination = null);

    /*! @brief 结束流操作，可选择性地写入最后的数据
     @return 返回一个异步对象
     */
    Integer end() async;

    /*! @brief 将给定的文件缓冲区写入流并结束流操作
     @param data 给定要写入的文件缓冲区数据
     @return 返回一个异步对象
     */
    Integer end(Buffer data) async;

    /*! @brief 将给定的文件缓冲区写入流并结束流操作
     @param data 给定要写入的文件缓冲区数据
     @param encoding 指定的编码方式，因为 data 为 Buffer 类型，此参数将被忽略
     @return 返回一个异步对象
     */
    Integer end(Buffer data, String encoding) async;

    /*! @brief 将给定的字符串写入流并结束流操作
     @param data 给定要写入的字符串数据
     @param encoding 指定字符串的编码方式，缺省为 "utf8"
     @return 返回一个异步对象
     */
    Integer end(String data, String encoding = "utf8") async;

    /*! @brief 将文件缓冲区内容写入物理设备 */
    flush() async;

    /*! @brief 关闭当前流对象 */
    close() async;

    /*! @brief 复制流数据到目标流中
     @param stm 目标流对象
     @param bytes 复制的字节数
     @return 返回复制的字节数
     */
    Long copyTo(Stream stm, Long bytes = -1) async;

    /*! @brief 查询和绑定流数据事件，相当于 on("data", func);
     @param data 读取到的数据
     */
    event data(Buffer data);

    /*! @brief 查询和绑定流关闭事件，相当于 on("close", func); */
    event close();

    /*! @brief 查询和绑定流错误事件，相当于 on("error", func);
     @param code 错误码
     */
    event error(Integer code);

    /*! @brief 获取流的读取器，兼容 WHATWG ReadableStreamDefaultReader 接口
     @return 返回 StreamReader 对象
    */
    StreamReader getReader();

    /*! @brief 维持 fibjs 进程不退出，在对象绑定期间阻止 fibjs 进程退出
     @return 返回当前对象
    */
    Stream ref();

    /*! @brief 允许 fibjs 进程退出，在对象绑定期间允许 fibjs 进程退出
     @return 返回当前对象
    */
    Stream unref();

    /*! @brief 销毁流。可选地触发 'error' 事件，并触发 'close' 事件。
     调用后，流将不再可用。
     @param err 可选的错误对象，将作为 'error' 事件触发
     @return 返回当前对象
    */
    Stream destroy(Value err = undefined) async;
};
