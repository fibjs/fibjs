/*! @brief performance 基础性能监控模块

 引用方法：
 ```JavaScript
 var performance = require('perf_hooks').performance;
 ```
 */
module performance
{
    /*! @brief 清除所有性能标记
     @param name 标记名称，如果为空则清除所有标记
     */
    static clearMarks(String name = "");

    /*! @brief 清除所有性能测量
     @param name 测量名称，如果为空则清除所有测量
     */
    static clearMeasures(String name = "");

    /*! @brief 创建一个性能标记

     options 为一个对象，包含以下属性：
      - detail: 附加信息
      - startTime: 开始时间，如果为空则使用当前时间

     @param name 标记名称
     @param options 附加选项
    */
    static mark(String name, Object options = {});

    /*! @brief 创建一个性能测量
     @param name 测量名称
     @param startMark 开始标记名称，如果为空则使用进程起始时间
     @param endMark 结束标记名称，如果为空则使用当前时间
    */
    static measure(String name, String startMark = "", String endMark = "");

    /*! @brief 创建一个性能测量

     options 为一个对象，包含以下属性：
      - detail: 附加信息
      - duration: 持续时间
      - end: 如果为 Number 类型，则表示结束时间，如果是 String 类型，则表示结束标记名称
      - start: 如果为 Number 类型，则表示开始时间，如果是 String 类型，则表示开始标记名称

     @param name 测量名称
     @param options 附加选项
    */
    static measure(String name, Object options = {});

    /*! @brief 获取所有性能记录
     @return 返回所有性能记录*/
    static NArray getEntries();

    /*! @brief 获取所有性能记录
     @param type 记录类型
     @return 返回所有性能记录*/
    static NArray getEntriesByType(String type);

    /*! @brief 获取所有性能记录
     @param name 记录名称
     @param type 记录类型
     @return 返回所有性能记录*/
    static NArray getEntriesByName(String name, String type = "");

    /*! @brief 查询当前进程时间 
     @return 返回当前进程时间*/
    static Number now();
};
