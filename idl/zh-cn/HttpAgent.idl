/*! @brief HttpAgent 是 Node.js 兼容的 HTTP 代理类，用于管理连接选项。
 它作为代理代理和其他连接池管理器的基类。

 ```JavaScript
 const http = require('http');
 const agent = new http.Agent({ keepAlive: true });
 ```
 */
interface HttpAgent : EventEmitter
{
    /*! @brief HttpAgent 构造函数
     @param options 代理选项：
       - keepAlive: 即使没有未完成的请求也保持套接字（默认: false）
       - maxSockets: 每个主机的最大套接字数（默认: Infinity）
       - maxTotalSockets: 最大套接字总数（默认: Infinity）
       - maxFreeSockets: 每个主机的最大空闲套接字数（默认: 256）
       - timeout: 套接字超时时间（毫秒）
     */
    HttpAgent(Object options = {});

    /*! @brief 返回给定请求选项的唯一键，用于连接池 */
    String getName(Object options = {});

    /*! @brief 销毁代理当前正在使用的所有套接字 */
    destroy();

    /*! @brief 查询和设置是否为将来的请求保留套接字 */
    Boolean keepAlive;

    /*! @brief 查询和设置每个主机的最大套接字数 */
    Integer maxSockets;

    /*! @brief 查询和设置所有主机的最大套接字总数 */
    Integer maxTotalSockets;

    /*! @brief 查询和设置每个主机的最大空闲套接字数 */
    Integer maxFreeSockets;

    /*! @brief 查询和设置 getName() 中使用的默认端口 */
    Integer defaultPort;

    /*! @brief 查询和设置 getName() 中使用的默认协议 */
    String protocol;

    /*! @brief 返回以 host:port 为键的空闲套接字映射 */
    readonly Object freeSockets;

    /*! @brief 返回以 host:port 为键的使用中的套接字映射 */
    readonly Object sockets;

    /*! @brief 返回所有主机的使用中套接字总数 */
    readonly Integer totalSocketCount;
};
