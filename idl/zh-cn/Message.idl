/*! @brief 基础消息对象

 Message 对象兼容于 mq 各个模块，可用于构建自定义消息处理系统，创建方法：
 ```JavaScript
 var mq = require("mq");
 var m = new mq.Message();
 ```
*/
interface Message : EventEmitter
{
    /*! @brief 指定消息类型 1，代表一个文本类型 */
    const TEXT = 1;

    /*! @brief 指定消息类型 2，代表一个二进制类型 */
    const BINARY = 2;

    /*! @brief 消息对象构造函数 */
    Message();

    /*! @brief 当前消息是否已经发送 */
    readonly Boolean sent;

    /*! @brief 消息的基本内容 */
    String value;

    /*! @brief 消息的基本参数 */
    readonly NArray params;

    /*! @brief 消息类型 */
    Integer type;

    /*! @brief 包含消息数据部分的流对象 */
    Stream body;

    /*! @brief 查询消息的 body 是否已被消费 */
    readonly Boolean bodyUsed;

    /*! @brief 从流内读取指定大小的数据，此方法为 body 相应方法的别名
     @param bytes 指定要读取的数据量，缺省为读取随机大小的数据块，读出的数据尺寸取决于设备
     @return 返回从流内读取的数据，若无数据可读，或者连接中断，则返回 null
     */
    Buffer read(Integer bytes = -1) async;

    /*! @brief 从流内读取剩余的全部数据，此方法为 body 相应方法的别名
     @return 返回从流内读取的数据，若无数据可读，或者连接中断，则返回 null
     */
    Buffer readAll() async;

    /*! @brief 写入给定的数据，此方法为 body 相应方法的别名
     @param data 给定要写入的数据
     @return 返回实际写入的字节数
     */
    Integer write(Buffer data) async;

    /*! @brief 写入给定的文本数据
     @param data 给定要写入的数据
     @return 此方法不会返回数据
     */
    String text(String data) async;

    /*! @brief 以文本编码解析消息中的数据
     @return 返回解析的结果
     */
    String text() async;

    /*! @brief 以二进制形式返回消息的数据部分
     @return 返回包含消息数据部分的 ArrayBuffer 对象
     */
    ArrayBuffer arrayBuffer() async;

    /*! @brief 以 Blob 形式返回消息中的数据部分
     @param type Blob 的 MIME 类型，默认为空字符串
     @return 返回包含消息数据部分的 Blob 对象
     */
    Blob blob(String type = "") async;

    /*! @brief 以 Buffer 形式返回消息中的数据部分
     @return 返回包含消息数据部分的 Buffer，若无数据则返回空 Buffer
     */
    Buffer bytes() async;

    /*! @brief 以 JSON 编码写入给定的数据
     @param data 给定要写入的数据
     @return 此方法不会返回数据
     */
    Variant json(Value data) async;

    /*! @brief 以 JSON 编码解析消息中的数据
     @return 返回解析的结果
     */
    Variant json() async;

    /*! @brief 以 msgpack 编码写入给定的数据
     @param data 给定要写入的数据
     @return 此方法不会返回数据
     */
    Variant pack(Value data) async;

    /*! @brief 以 msgpack 编码解析消息中的数据
     @return 返回解析的结果
     */
    Variant pack() async;

    /*! @brief 消息数据部分的长度 */
    readonly Long length;

    /*! @brief 设置当前消息处理结束，Chain 处理器不再继续后面的事务
     @return 成功返回 0
     */
    Integer end() async;

    /*! @brief 写入给定的数据并设置当前消息处理结束
     @param data 给定要写入的数据
     @return 成功返回 0
     */
    Integer end(Buffer data) async;

    /*! @brief 写入给定的数据并设置当前消息处理结束
     @param data 给定要写入的数据
     @param encoding 指定编码方式，由于 data 是 Buffer 类型，此参数将被忽略
     @return 成功返回 0
     */
    Integer end(Buffer data, String encoding) async;

    /*! @brief 写入给定的字符串数据并设置当前消息处理结束
     @param data 给定要写入的字符串数据
     @param encoding 指定字符串的编码方式，默认为 "utf8"
     @return 成功返回 0
     */
    Integer end(String data, String encoding = "utf8") async;

    /*! @brief 查询当前消息是否结束
     @return 结束则返回 true
    */
    Boolean isEnded();

    /*! @brief 清除消息的内容 */
    clear();

    /*! @brief 发送格式化消息到给定的流对象
     @param stm 指定接收格式化消息的流对象
     @param options 指定发送选项
     */
    sendTo(Stream stm, Object options = {}) async;

    /*! @brief 从给定的缓存流对象中读取格式化消息，并解析填充对象
     @param stm 指定读取格式化消息的流对象
     @param options 指定读取选项
     */
    readFrom(Stream stm, Object options = {}) async;

    /*! @brief 查询消息 readFrom 时的流对象 */
    readonly Stream stream;

    /*! @brief 查询和设置消息处理的最后错误 */
    String lastError;

    /*! @brief 复制当前消息对象
     @return 返回复制的消息对象
    */
    Message clone();

    /*! @brief 将消息的 body 流切换到流动读取模式
     @return 返回消息对象
     */
    Message resume();

    /*! @brief 暂停消息的 body 流的自动读取模式。此方法仅为兼容，调用后不会有实际效果
     @return 返回消息对象
     */
    Message pause();

    /*! @brief 将消息的 body 流数据管道传输到目标流
     @param destination 目标流对象
     @param options 管道选项，可选
     @return 返回目标流对象
     */
    Value pipe(Value destination, Object options = {});

    /*! @brief 移除消息的 body 流的所有管道目标。此方法仅为兼容，调用后不会有实际效果
     @param destination 要取消管道的特定可写目标
     */
    unpipe(Stream destination = null);

    /*! @brief 查询和绑定流数据事件，相当于 on("data", func);
     @param data 读取到的数据
     */
    event data(Buffer data);

    /*! @brief 查询和绑定流关闭事件，相当于 on("close", func); */
    event close();

    /*! @brief 查询和绑定流错误事件，相当于 on("error", func);
     @param code 错误码
     */
    event error(Integer code);
};
