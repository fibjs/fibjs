/* brief 该对象允许您与异步操作（例如提取请求）进行通信，并在需要时通过 AbortController 对象中止它 */
interface AbortSignal : EventEmitter
{
    /*! @brief 用于中止一个或多个 Web 请求
     @param reason 一个可选的字符串，用于描述中止请求的原因
     @return 返回一个 AbortSignal 对象
    */
    static AbortSignal abort(String reason = "AbortError");

    /*! @brief 用于中止一个或多个 Web 请求
     @param reason 一个任意类型的值，用于描述中止请求的原因
     @return 返回一个 AbortSignal 对象
    */
    static AbortSignal abort(Value reason);

    /*! @brief 创建一个会在超时后自动中止的 AbortSignal
     @param ms 超时时间（毫秒）
     @return 返回一个将在 ms 毫秒后中止的 AbortSignal 对象
    */
    static AbortSignal timeout(Number ms);

    /*! @brief 如果请求已中止，则抛出异常 */
    throwIfAborted();

    /*! @brief 用于检查是否已请求中止 */
    readonly Boolean aborted;

    /*! @brief 获取中止请求的原因 */
    readonly Value reason;

    /*! @brief 事件处理程序，当中止请求时触发 */
    event abort();
};
