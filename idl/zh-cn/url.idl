/*! @brief URL 处理模块，提供 URL 解析、格式化、文件路径转换和国际化域名处理等功能

url 模块实现了完整的 URL 处理功能，兼容 WHATWG URL 标准和传统 Node.js API。
它提供了 URL 对象、URLSearchParams 对象以及各种实用的 URL 操作函数。

## 主要功能

- **URL 解析和格式化**: 支持解析和格式化各种 URL 格式
- **文件 URL 处理**: 提供文件路径与 file:// URL 之间的转换
- **国际化域名**: 支持 ASCII 和 Unicode 域名之间的转换
- **查询参数处理**: 集成 URLSearchParams 提供强大的查询参数操作
- **相对路径解析**: 支持相对 URL 的解析和合并

## 基本用法

### 1. 创建和操作 URL 对象

```JavaScript
const { URL, URLSearchParams } = require('url');

// 创建 URL 对象
const myURL = new URL('https://example.com:8080/path?key=value#hash');

// 访问 URL 各部分
console.log(myURL.protocol);  // 'https:'
console.log(myURL.hostname);  // 'example.com'
console.log(myURL.port);      // '8080'
console.log(myURL.pathname);  // '/path'
console.log(myURL.search);    // '?key=value'
console.log(myURL.hash);      // '#hash'

// 修改 URL
myURL.pathname = '/new-path';
myURL.searchParams.set('new-key', 'new-value');
console.log(myURL.href);      // 'https://example.com:8080/new-path?key=value&new-key=new-value#hash'
```

### 2. 传统 API 兼容

```JavaScript
const url = require('url');

// 解析 URL 字符串
const parsed = url.parse('https://example.com/path?key=value#hash');
console.log(parsed.hostname);  // 'example.com'

// 格式化 URL 对象
const formatted = url.format({
  protocol: 'https:',
  hostname: 'example.com',
  pathname: '/path'
});
console.log(formatted);  // 'https://example.com/path'

// 解析相对 URL
const resolved = url.resolve('https://example.com/foo/', '../bar');
console.log(resolved);   // 'https://example.com/bar'
```

### 3. 文件 URL 处理

```JavaScript
const url = require('url');

// 路径转文件 URL
const fileURL = url.pathToFileURL('/path/to/file.txt');
console.log(fileURL.href);  // 'file:///path/to/file.txt'

// 文件 URL 转路径
const filePath = url.fileURLToPath('file:///path/to/file.txt');
console.log(filePath);      // '/path/to/file.txt'
```

### 4. 国际化域名处理

```JavaScript
const url = require('url');

// Unicode 域名转 ASCII
const ascii = url.domainToASCII('测试.com');
console.log(ascii);         // 'xn--0zwm56d.com'

// ASCII 域名转 Unicode
const unicode = url.domainToUnicode('xn--0zwm56d.com');
console.log(unicode);       // '测试.com'
```
*/
module url
{
    /*! @brief 将 URL 字符串格式化为标准的 URL 字符串
     @param href URL 字符串
     @return 格式化后的 URL 字符串
     */
    static String format(String href);

    /*! @brief 使用 URL 组件对象构造 URL 字符串
     @param args URL 组件对象，支持的字段有：protocol, slashes, username, password, hostname, port, pathname, query, hash
     @return 构造的 URL 字符串
     */
    static String format(Object args);

    /*! @brief 格式化 URL 对象为字符串，支持格式化选项
     @param urlObject 要格式化的 URL 对象
     @param options 格式化选项，支持的字段有：fragment（是否包含片段）, unicode（是否使用 Unicode 显示域名）, auth（是否包含认证信息）
     @return 格式化后的 URL 字符串
     */
    static String format(UrlObject urlObject, Object options = {});

    /*! @brief 解析 URL 字符串为 URL 对象（传统 API）
     @param url 要解析的 URL 字符串
     @param parseQueryString 是否将查询字符串解析为对象，默认为 false
     @param slashesDenoteHost 是否将 '//' 后到下一个 '/' 前的字符串解析为主机，默认为 false
     @return 解析后的 UrlObject 对象
     */
    static UrlObject parse(String url, Boolean parseQueryString = false, Boolean slashesDenoteHost = false);

    /*! @brief 解析相对 URL 并合并为绝对 URL
     @param _from 基础 URL 字符串
     @param to 要解析的相对 URL 字符串
     @return 合并后的绝对 URL 字符串
     */
    static String resolve(String _from, String to);

    /*! @brief 创建 URL 对象，参见 UrlObject
     @return 新的 UrlObject 实例
     */
    static UrlObject new URL();

    /*! @brief 创建 URLSearchParams 对象，参见 URLSearchParams
     @return 新的 URLSearchParams 实例
     */
    static URLSearchParams new URLSearchParams();

    /*! @brief 将文件 URL 对象转换为平台相关的文件路径
     @param url 文件 URL 对象（必须是 file: 协议）
     @param options 转换选项，支持 windows 字段指定是否强制使用 Windows 路径格式
     @return 转换后的文件路径字符串
     */
    static String fileURLToPath(UrlObject url, Object options = {});

    /*! @brief 将文件 URL 字符串转换为平台相关的文件路径
     @param url 文件 URL 字符串（必须是 file: 协议）
     @param options 转换选项，支持 windows 字段指定是否强制使用 Windows 路径格式
     @return 转换后的文件路径字符串
     */
    static String fileURLToPath(String url, Object options = {});

    /*! @brief 将文件路径转换为文件 URL 对象
     @param path 要转换的文件路径
     @param options 转换选项，支持 windows 字段指定路径是否为 Windows 格式
     @return 转换后的文件 URL 对象
     */
    static UrlObject pathToFileURL(String path, Object options = {});

    /*! @brief 将国际化域名转换为 ASCII 编码（Punycode）
     @param domain 要转换的域名（可包含 Unicode 字符）
     @return ASCII 编码的域名
     */
    static String domainToASCII(String domain);

    /*! @brief 将 ASCII 编码的域名转换为 Unicode 显示格式
     @param domain 要转换的 ASCII 域名
     @return Unicode 格式的域名
     */
    static String domainToUnicode(String domain);
};
