/*! @brief DOMTokenList 对象，表示一组空格分隔的标记，常用于 classList 属性

 DOMTokenList 是表示一组空格分隔的标记的接口。它可以用于表示 CSS 类列表。

 示例:
 ```JavaScript
 var xml = require('xml');
 var doc = xml.parse('<div class="foo bar"></div>', 'text/html');
 var div = doc.documentElement;
 var classList = div.classList;
 console.log(classList.length); // 2
 console.log(classList.item(0)); // "foo"
 console.log(classList.contains("bar")); // true
 classList.add("baz");
 console.log(div.className); // "foo bar baz"
 ```
 */
interface DOMTokenList : object
{
    /*! @brief 返回指定索引处的标记 */
    readonly String operator[];

    /*! @brief 返回集合中的标记数量 */
    readonly Integer length;

    /*! @brief 返回集合中所有标记的字符串表示，用空格分隔 */
    readonly String value;

    /*! @brief 返回指定索引处的标记
     @param index 标记的索引
     @return 返回标记字符串，如果索引超出范围则返回 null
     */
    String item(Integer index);

    /*! @brief 检查集合中是否包含指定的标记
     @param token 要检查的标记
     @return 如果包含该标记则返回 true，否则返回 false
     */
    Boolean contains(String token);

    /*! @brief 向集合中添加一个或多个标记
     @param tokens 要添加的标记，可变参数
     */
    add(...tokens);

    /*! @brief 从集合中移除一个或多个标记
     @param tokens 要移除的标记，可变参数
     */
    remove(...tokens);

    /*! @brief 如果标记存在则移除它，否则添加它
     @param token 要切换的标记
     @param force 可选。如果为 true，则只添加标记；如果为 false，则只移除标记
     @return 如果操作后标记存在则返回 true，否则返回 false
     */
    Boolean toggle(String token, ...force);

    /*! @brief 用新标记替换现有标记
     @param oldToken 要替换的标记
     @param newToken 新标记
     @return 如果替换成功则返回 true，否则返回 false
     */
    Boolean replace(String oldToken, String newToken);

    /*! @brief 返回集合中所有标记的字符串表示，用空格分隔
     @return 返回标记字符串
     */
    String toString();
};
