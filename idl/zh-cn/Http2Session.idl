/*! @brief Http2Session 表示活动的 HTTP/2 会话，管理连接和所有流

Http2Session 实例不应由用户直接构造。服务端在接收到新的 HTTP/2 连接时创建。客户端使用 http2.connect() 创建会话。
*/
interface Http2Session : EventEmitter
{
    /*! @brief 查询此会话的远端设置 */
    readonly Object remoteSettings;

    /*! @brief 查询此会话的本地设置 */
    readonly Object localSettings;

    /*! @brief 查询会话是否已销毁 */
    readonly Boolean destroyed;

    /*! @brief 查询会话是否已关闭 */
    readonly Boolean closed;

    /*! @brief 查询此会话协商的 ALPN 协议 */
    readonly String alpnProtocol;

    /*! @brief 查询此会话的底层 TLSSocket */
    readonly Stream socket;

    /*! @brief 发起新的 HTTP/2 流以发送请求（仅客户端）
     @param headers 包含请求头的对象，必须包含 :method 和 :path 伪头部
     @param options 可选的流创建选项
     @return 返回新请求的 Http2Stream 对象
    */
    Http2Stream request(Object headers, Object options = {});

    /*! @brief 向远端发送 GOAWAY 帧并优雅关闭会话
     @param code HTTP/2 错误码，默认为 NGHTTP2_NO_ERROR (0)
     @param lastStreamId 本地处理的最后一个流 ID，默认为 0
    */
    goaway(Integer code = 0, Integer lastStreamId = 0);

    /*! @brief 向远端发送 PING 帧
     @return 返回往返时间（毫秒）
    */
    Integer ping() async;

    /*! @brief 更新此会话的本地设置
     @param settings 包含要更新的设置的对象
    */
    settings(Object settings);

    /*! @brief 优雅关闭会话，允许现有流完成 */
    close() async;

    /*! @brief 立即销毁会话，中止所有流 */
    destroy();

    /*! @brief 当创建新流时触发（服务端）
     @param stream 新创建的 Http2Stream
     @param headers 请求头对象
    */
    event stream(Http2Stream stream, Object headers);

    /*! @brief 当会话收到 GOAWAY 帧时触发 */
    event goaway();

    /*! @brief 当会话发生错误时触发
     @param err 错误对象
    */
    event error(Object err);
};
