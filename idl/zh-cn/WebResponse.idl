/*! @brief Web Fetch API 标准的 Response 对象

 WebResponse 是 Web Fetch API 标准的 Response 接口实现，用于表示一个 HTTP 响应。
 它封装了 HttpResponse，提供与浏览器兼容的标准接口。

 使用示例：
 ```JavaScript
 // 通过 fetch 获取
 const resp = await fetch('http://example.com');
 console.log(resp.status);        // 200
 console.log(resp.statusText);    // "OK"
 const text = await resp.text();

 // 直接创建
 const resp2 = new Response('Hello', { status: 200, statusText: 'OK' });
 ```
*/
interface WebResponse : object
{
    /*! @brief WebResponse 构造函数
     @param body 响应体内容，可以是字符串、Buffer、Blob 或 null
     @param options 选项对象，支持 status、statusText、headers 属性
    */
    WebResponse(Value body, Object options = {});

    /*! @brief WebResponse 构造函数
     @param options 选项对象，支持 status、statusText、headers 属性
    */
    WebResponse(Object options = {});

    /*! @brief 查询响应的 HTTP 状态码 */
    readonly Integer status;

    /*! @brief 查询响应的 HTTP 状态消息 */
    readonly String statusText;

    /*! @brief 查询响应是否成功（状态码 200-299） */
    readonly Boolean ok;

    /*! @brief 查询响应的类型 */
    readonly String type;

    /*! @brief 查询响应的 URL */
    readonly String url;

    /*! @brief 查询响应是否经过了重定向 */
    readonly Boolean redirected;

    /*! @brief 查询响应的 body 是否已经被消费 */
    readonly Boolean bodyUsed;

    /*! @brief 查询响应的 Headers 对象 */
    readonly Headers headers;

    /*! @brief 查询响应的 body 流对象 */
    readonly Stream body;

    /*! @brief 以文本形式读取响应体
     @return 返回文本内容
    */
    String text() promise;

    /*! @brief 以 JSON 形式读取响应体
     @return 返回解析后的 JSON 值
    */
    Variant json() promise;

    /*! @brief 以 ArrayBuffer 形式读取响应体
     @return 返回 ArrayBuffer 对象
    */
    ArrayBuffer arrayBuffer() promise;

    /*! @brief 以 Blob 形式读取响应体
     @return 返回 Blob 对象
    */
    Blob blob() promise;

    /*! @brief 以 Uint8Array 形式读取响应体
     @return 返回 Uint8Array 对象
    */
    Buffer bytes() promise;

    /*! @brief 克隆响应对象
     @return 返回新的 WebResponse 对象
    */
    WebResponse clone();

    /*! @brief 创建一个 JSON 响应
     @param data 要序列化为 JSON 的数据
     @param options 选项对象，支持 status、statusText、headers 属性
     @return 返回新的 WebResponse 对象
    */
    static WebResponse json(Value data, Object options = {});

    /*! @brief 创建一个重定向响应
     @param url 重定向的目标 URL
     @param status 重定向状态码，默认 302
     @return 返回新的 WebResponse 对象
    */
    static WebResponse redirect(String url, Integer status = 302);

    /*! @brief 创建一个错误响应
     @return 返回新的 WebResponse 对象
    */
    static WebResponse error();
};
