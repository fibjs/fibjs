/*! @brief The X509CertificateRequest object is used to create x509 certificate requests and belongs to the crypto module

A certificate request can be created with crpto.createCertificateRequest, for example:

```JavaScript
var crypto = require('crypto');

var pk = crypto.createPrivateKey(rsa4096_pem);
var req = crypto.createCertificateRequest({
    key: pk,
    subject: {
        C: "CN",
        O: "baoz.cn",
        CN: "baoz.me"
    }
});
```

A formal certificate object can be generated by calling the issue method of X509CertificateRequest, for example:

```JavaScript
let crt = req.issue({
    key: issuer_pk,
    issuer: {
        C: "CN",
        O: "baoz.cn",
        CN: "baoz.me"
    }
}); 
```

Note that the purpose of the X509CertificateRequest object is to create an x509 certificate request, not the certificate itself; to obtain a valid certificate it must also be signed. In addition, the public key used to sign the certificate must be the same as the public key used in the certificate request.
 */
interface X509CertificateRequest : object
{
    /*! @brief The subject of the certificate request */
    readonly String subject;

    /*! @brief The certified public key of the certificate request */
    readonly KeyObject publicKey;

    /*! @brief The subject alternative names of the certificate request */
    readonly String subjectAltName;

    /*! @brief The information access extension of the certificate request; returns a newline-separated list of access descriptions. Each line begins with the access method and the type of the access location, followed by a colon and the value associated with the access location */
    readonly String infoAccess;

    /*! @brief The raw binary data of the certificate request */
    readonly Buffer raw;

    /*! @brief The PEM encoding of the certificate request */
    readonly String pem;

    /*! @brief Checks whether the certificate request's public key matches the signature of the given private key
    @param privateKey the private key
    @return returns true if they match, false otherwise
    */
    Boolean checkPrivateKey(KeyObject privateKey);

    /*! @brief Issues a formal certificate according to the request content

     The parameters in options are used to call crypto.createPrivateKey to create the private key object; the following signing parameters are also supported:
      - issuer: the issuer's subject information, containing subject information as key/value pairs
      - ca: whether it is a CA certificate, default false
      - pathlen: the maximum length of the certificate chain, default -1
      - validFrom: the certificate's effective time, default the current time
      - validTo: the certificate's expiry time; if days is also set, validTo takes precedence
      - days: the certificate validity period, default 100 days
      - hashAlgorithm: the hash algorithm for signing, default 'sha256'
      - keyUsage: the key usage of the certificate, provided as an array, default []; supported values are:
        - 'digitalSignature': digital signature
        - 'nonRepudiation': non-repudiation
        - 'keyEncipherment': key encipherment
        - 'dataEncipherment': data encipherment
        - 'keyAgreement': key agreement
        - 'keyCertSign': certificate signing
        - 'cRLSign': CRL signing
        - 'encipherOnly': encipher only
        - 'decipherOnly': decipher only

     - type: the Nescape type of the certificate, provided as an array, default []; supported values are:
        - 'client': client
        - 'server': server
        - 'email': email
        - 'objsign': object signing
        - 'reserved': reserved
        - 'sslCA': SSL CA
        - 'emailCA': email CA
        - 'objCA': object CA

     @param options the certificate issuance options
     @return returns the issued certificate object
    */
    X509Certificate issue(Object options);
};
