#!/bin/bash

inform() {
	echo ""
	echo "submodule vender is not existed!"
	echo "you can execute the given command to init and update it."
	echo " \$ git submodule init"
	echo " \$ git submodule update"
	echo ""
	exit 1
}

TIME_BEGIN=$(date +%s)

SOURCE_ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "${SOURCE_ROOT}" || exit 1

# Tells build_env.sh which directory the docker build has to re-enter.
export BUILD_ENTRY="${SOURCE_ROOT}"

vender_dist=0

new_args=()
for arg in "$@"; do
        if [ "$arg" == "ci" ]; then
                vender_dist=1
        elif [ "$arg" == "dev" ]; then
                # `dev` used to mean "build vender from source".  That is the
                # default now; the option was often mistaken for "debug build".
                echo "notice: the 'dev' option is no longer needed - the default build compiles vender from source"
        else
                new_args+=("$arg")
        fi
done
set -- "${new_args[@]}"

# The default build compiles the vendored libraries from the tree, so local
# changes under vender/ are always picked up.  `ci` - and a pinned VENDER_TAG -
# use the prebuilt fibjs_vender dist instead.
if [ "$vender_dist" == "1" ] || [ ! -z $VENDER_TAG ]; then
        export USE_VENDER_DIST=1
fi

if [ ! -f "${SOURCE_ROOT}/vender/build" ]; then
        git submodule update --init --recursive
fi

if [ ! -f "${SOURCE_ROOT}/vender/build" ]; then
        inform
fi

# The whole tree (vender, fibjs, program, addons, installer) is configured and
# built in one pass.  The vendored libraries come either from the sources in the
# tree (default) or from the prebuilt fibjs_vender dist (ci).  A caller may
# extend the cmake arguments through BUILD_CMAKE_EXTRA_ARGS.
if [ "$USE_VENDER_DIST" == "1" ]; then
        export BUILD_CMAKE_EXTRA_ARGS="-DBT_VENDER=dist ${BUILD_CMAKE_EXTRA_ARGS}"
else
        export BUILD_CMAKE_EXTRA_ARGS="-DBT_VENDER=in-tree ${BUILD_CMAKE_EXTRA_ARGS}"
fi

# The addons are part of the default build (`dev` is gone).
export BUILD_CMAKE_EXTRA_ARGS="${BUILD_CMAKE_EXTRA_ARGS} -DFIBJS_ADDONS=ON"

. "${SOURCE_ROOT}/vender/build_tools/scripts/build_env.sh"
. "${SOURCE_ROOT}/vender/build_tools/scripts/build"

bldred="\033[1m\033[31m"
txtrst="\033[0m"
TIME_END=$(($(date -u +%s) - $TIME_BEGIN))

printf "\n\n"
printf "\t${bldred} _______ _________ ______  _________ _______ ${txtrst}\n"
printf "\t${bldred}(  ____ \\\\\\__   __/(  ___ \\ \\__    _/(  ____ \\\\${txtrst}\n"
printf "\t${bldred}| (    \\/   ) (   | (   ) )   )  (  | (    \\/${txtrst}\n"
printf "\t${bldred}| (__       | |   | (__/ /    |  |  | (_____ ${txtrst}\n"
printf "\t${bldred}|  __)      | |   |  __ (     |  |  (_____  )${txtrst}\n"
printf "\t${bldred}| (         | |   | (  \\ \\    |  |        ) |${txtrst}\n"
printf "\t${bldred}| (_     ___) (___| (___) )/\\_)  )  /\\____) |${txtrst}\n"
printf "\t${bldred}(__/     \\_______/(______/ \\____/   \\_______)${txtrst}\n"
printf ""

printf "\\n\\tFIBJS has been successfully built during  $(($TIME_END / 3600)):$(($TIME_END % 3600 / 60)):$(($TIME_END % 60))\\n\\n"

printf "\\tFor more information:\\n\\n"
printf "\\twebsite: https://fibjs.org\\n"
printf "\\trepository: https://github.com/fibjs\\n"
printf "\n\n"
