FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy fibjs binaries from build context
ARG TARGETPLATFORM
COPY binaries/ /tmp/binaries/

# Copy the correct binary based on target platform
RUN case ${TARGETPLATFORM} in \
    "linux/amd64") \
    cp /tmp/binaries/fibjs-amd64 /usr/local/bin/fibjs ;; \
    "linux/arm64") \
    cp /tmp/binaries/fibjs-arm64 /usr/local/bin/fibjs ;; \
    "linux/arm/v7") \
    cp /tmp/binaries/fibjs-arm /usr/local/bin/fibjs ;; \
    "linux/ppc64le") \
    cp /tmp/binaries/fibjs-ppc64le /usr/local/bin/fibjs ;; \
    "linux/riscv64") \
    cp /tmp/binaries/fibjs-riscv64 /usr/local/bin/fibjs ;; \
    *) \
    echo "Unsupported platform: ${TARGETPLATFORM}" && exit 1 ;; \
    esac

# Make it executable and clean up
RUN chmod +x /usr/local/bin/fibjs && \
    rm -rf /tmp/binaries

# Ensure PATH includes /usr/local/bin
ENV PATH="/usr/local/bin:${PATH}"

CMD ["fibjs"]
