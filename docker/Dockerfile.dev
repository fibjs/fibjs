FROM ubuntu:24.04

# No apt packages are needed:
#   - fibjs links OpenSSL statically and embeds its own root CA bundle
#     (fibjs/src/crypto/root_ca.cpp, loaded by SecureContext::SetRootCerts),
#     so HTTPS works without /etc/ssl/certs and ca-certificates.
#   - /usr/local/bin is already in the base image PATH.
#
# Copy only the binary for the target platform. Copying the whole binaries/
# directory (all architectures) and then cp-ing it into place keeps two extra
# ~70MB copies in the image.

ARG FIBJS_BINARY
COPY binaries/${FIBJS_BINARY} /usr/local/bin/fibjs

CMD ["fibjs"]